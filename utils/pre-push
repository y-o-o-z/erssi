#!/bin/sh
# pre-push - checks before anything reaches GitHub. Install once:
#   ln -sf ../../utils/pre-push .git/hooks/pre-push
#
# 1. the build works and `meson test` passes (when Build/ exists)
# 2. every pushed commit is authored and committed by y-o-o-z (noreply
#    address) and carries no AI attribution trailer
# 3. no line added by the pushed commits matches a private pattern from
#    ~/.config/git-private-patterns (one extended regex per line; the file
#    stays on your machine, so the patterns themselves are never published)
# Skip in an emergency with: git push --no-verify
set -u
ROOT=$(git rev-parse --show-toplevel)
EMAIL='136268860+y-o-o-z@users.noreply.github.com'
PATTERNS="$HOME/.config/git-private-patterns"
ZERO=0000000000000000000000000000000000000000
fail=0
bad() { printf 'pre-push: %s\n' "$*" >&2; fail=1; }

while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$ZERO" ] && continue          # branch deletion
    case "$local_ref" in refs/tags/*) continue ;; esac
    if [ "$remote_sha" = "$ZERO" ]; then
        range=$(git rev-list "$local_sha" --not --remotes 2>/dev/null)
    else
        range=$(git rev-list "$remote_sha..$local_sha" 2>/dev/null)
    fi
    for c in $range; do
        who=$(git log -1 --format='%ae %ce' "$c")
        [ "$who" = "$EMAIL $EMAIL" ] || bad "$(git log -1 --format='%h %s' "$c"): author/committer $who"
        if git log -1 --format=%B "$c" | grep -qiE '^co-authored-by:.*(claude|anthropic)|generated with \[?claude'; then
            bad "$(git log -1 --format='%h %s' "$c"): AI attribution trailer"
        fi
        if [ -r "$PATTERNS" ]; then
            hits=$(git show --format= --unified=0 "$c" | grep '^+' | grep -v '^+++' | grep -iEf "$PATTERNS" | head -3)
            [ -n "$hits" ] && bad "$(git log -1 --format='%h %s' "$c"): private data: $hits"
        fi
    done
done

[ "$fail" = 0 ] || { echo "pre-push: push refused" >&2; exit 1; }

if [ -f "$ROOT/Build/build.ninja" ]; then
    ninja -C "$ROOT/Build" >/dev/null 2>&1 || { echo "pre-push: build failed (ninja -C Build)" >&2; exit 1; }
    meson test -C "$ROOT/Build" >/dev/null 2>&1 || { echo "pre-push: tests failed (meson test -C Build)" >&2; exit 1; }
    echo "pre-push: build and tests ok"
fi
exit 0
