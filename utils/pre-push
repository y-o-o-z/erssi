#!/bin/sh
# pre-push - checks before anything reaches GitHub. Install once:
#   ln -sf ../../utils/pre-push .git/hooks/pre-push
#
# 1. the build works and `meson test` passes (when Build/ exists)
# 2. every pushed commit (branches and tags) is authored and committed by
#    y-o-o-z (noreply address) and carries no AI attribution trailer;
#    annotated tags are tagged by y-o-o-z, and a release tag (shellter-v*)
#    carries a valid SSH signature by the key in utils/allowed_signers;
#    src/fe-ansi/default-files-known.h lists every shipped startup/theme
# 3. nothing that the push publishes matches a private pattern from
#    ~/.config/git-private-patterns (one extended regex per line, case
#    insensitive; the file stays on your machine, so the patterns themselves
#    are never published): lines added by the pushed commits, their commit
#    messages and file paths, annotated tag messages and the ref names.
#    Without the file the push is refused; PREPUSH_NO_PATTERNS=1 git push
#    pushes once without this check.
# Skip in an emergency with: git push --no-verify
set -u
ROOT=$(git rev-parse --show-toplevel)
EMAIL='136268860+y-o-o-z@users.noreply.github.com'
PATTERNS="$HOME/.config/git-private-patterns"
ZERO=0000000000000000000000000000000000000000
fail=0
bad() { printf 'pre-push: %s\n' "$*" >&2; fail=1; }

if [ -r "$PATTERNS" ]; then
    grep -Eq -f "$PATTERNS" </dev/null 2>/dev/null; [ $? -le 1 ] ||
        { echo "pre-push: $PATTERNS has an invalid pattern (grep -E): push refused" >&2; exit 1; }
    check_private=1
elif [ "${PREPUSH_NO_PATTERNS:-}" = 1 ]; then
    echo "pre-push: warning: $PATTERNS missing - private data check skipped (PREPUSH_NO_PATTERNS=1)" >&2
    check_private=0
else
    cat >&2 <<EOF
pre-push: $PATTERNS is missing or unreadable - push refused,
          the private data check cannot run. Create it (one extended regex
          per line), or push once without the check:
            PREPUSH_NO_PATTERNS=1 git push
EOF
    exit 1
fi
# up to 3 lines of stdin that match a private pattern
# (blank and # lines skipped: an empty pattern would match every line)
private() { grep -iEf "$PATTERNS_CLEAN" | head -3; }
PATTERNS_CLEAN=$(mktemp)
trap 'rm -f "$PATTERNS_CLEAN"' EXIT
grep -v -e '^[[:space:]]*$' -e '^#' "$PATTERNS" > "$PATTERNS_CLEAN" 2>/dev/null || true

pushed=""
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$ZERO" ] && continue          # deletion
    if [ "$check_private" = 1 ]; then
        hits=$(printf '%s\n%s\n' "$local_ref" "$remote_ref" | private)
        [ -n "$hits" ] && bad "ref name: private data: $hits"
    fi
    # tags too: a tag can carry commits that no branch on GitHub has
    tip=$(git rev-parse -q --verify "$local_sha^{commit}") || continue
    pushed="$pushed $tip"
    # what GitHub does not have yet; when the remote tip is unknown here
    # (force push without fetching), everything not on a known remote
    if [ "$remote_sha" != "$ZERO" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        range=$(git rev-list "$tip" --not "$remote_sha" --remotes) || range=FAIL
    else
        range=$(git rev-list "$tip" --not --remotes) || range=FAIL
    fi
    [ "$range" = FAIL ] && { bad "$local_ref: cannot list the pushed commits"; continue; }
    for c in $range; do
        who=$(git log -1 --format='%ae %ce' "$c")
        [ "$who" = "$EMAIL $EMAIL" ] || bad "$(git log -1 --format='%h %s' "$c"): author/committer $who"
        if git log -1 --format=%B "$c" | grep -qiE '^co-authored-by:.*(claude|anthropic)|generated with \[?claude'; then
            bad "$(git log -1 --format='%h %s' "$c"): AI attribution trailer"
        fi
        if [ "$check_private" = 1 ]; then
            hits=$(git show --format= --unified=0 "$c" | grep '^+' | grep -v '^+++ \(b/\|/dev/null\)' | private)
            [ -n "$hits" ] && bad "$(git log -1 --format='%h %s' "$c"): private data in the diff: $hits"
            hits=$(git log -1 --format=%B "$c" | private)
            [ -n "$hits" ] && bad "$(git log -1 --format='%h %s' "$c"): private data in the commit message: $hits"
            hits=$(git -c core.quotePath=false show --name-only --format= "$c" | private)
            [ -n "$hits" ] && bad "$(git log -1 --format='%h %s' "$c"): private data in a file path: $hits"
        fi
    done
    # an annotated tag has its own author line and message
    if [ "$(git cat-file -t "$local_sha")" = tag ]; then
        tagger=$(git cat-file -p "$local_sha" | sed -n 's/^tagger .*<\(.*\)>.*/\1/p')
        [ "$tagger" = "$EMAIL" ] || bad "$local_ref: tagger $tagger"
        # a release tag must be signed by the release key (utils/allowed_signers)
        case "$local_ref" in
            refs/tags/shellter-v*)
                # the name inside the signed object must be this tag's
                [ "$(git cat-file tag "$local_sha" | sed -n '1,/^$/s/^tag //p')" = "${local_ref#refs/tags/}" ] ||
                    bad "$local_ref: the tag object names another tag"
                git -c gpg.format=ssh -c gpg.ssh.allowedSignersFile="$ROOT/utils/allowed_signers" \
                    -c gpg.program=false -c gpg.openpgp.program=false -c gpg.x509.program=false -c gpg.ssh.program=ssh-keygen \
                    verify-tag "$local_sha" >/dev/null 2>&1 ||
                    bad "$local_ref: not signed by the release key (git tag -s; utils/allowed_signers)" ;;
        esac
        if [ "$check_private" = 1 ]; then
            # the message: everything after the header, without a signature (PGP or SSH)
            hits=$(git cat-file -p "$local_sha" | sed '1,/^$/d; /^-----BEGIN .*SIGNATURE-----/,$d' | private)
            [ -n "$hits" ] && bad "$local_ref: private data in the tag message: $hits"
        fi
    fi
done

# every shipped version of startup and the themes must be in the list erssi
# uses to tell an unchanged ~/.erssi copy from the user's own - checked for
# each pushed commit from its own history and files (not the working tree)
known=$(mktemp)
for tip in $pushed; do
    git cat-file -e "$tip:src/fe-ansi/default-files-known.h" 2>/dev/null || continue
    if sh "$ROOT/utils/default-file-hashes.sh" "$tip" "$known" >/dev/null 2>&1; then
        git show "$tip:src/fe-ansi/default-files-known.h" | cmp -s - "$known" ||
            bad "$(git log -1 --format=%h "$tip"): src/fe-ansi/default-files-known.h is out of date - run utils/default-file-hashes.sh and commit it"
    else
        bad "utils/default-file-hashes.sh failed for $(git log -1 --format=%h "$tip")"
    fi
done
rm -f "$known"

[ "$fail" = 0 ] || { echo "pre-push: push refused" >&2; exit 1; }

if [ -f "$ROOT/Build/build.ninja" ]; then
    ninja -C "$ROOT/Build" >/dev/null 2>&1 || { echo "pre-push: build failed (ninja -C Build)" >&2; exit 1; }
    meson test -C "$ROOT/Build" >/dev/null 2>&1 || { echo "pre-push: tests failed (meson test -C Build)" >&2; exit 1; }
    # the build uses the working tree; say so when that is not what is pushed
    head=$(git rev-parse HEAD)
    case " $pushed " in *" $head "*) ;; *) [ -n "$pushed" ] && echo "pre-push: note: tested HEAD, which is not the pushed commit" >&2 ;; esac
    git diff --quiet HEAD -- 2>/dev/null || echo "pre-push: note: tested the working tree, which has uncommitted changes" >&2
    echo "pre-push: build and tests ok"
fi
exit 0
