From ab22e952ad02ef0cccc83035e5c1685b010c087b Mon Sep 17 00:00:00 2001
From: y-o-o-z <136268860+y-o-o-z@users.noreply.github.com>
Date: Sat, 3 Oct 2026 21:05:33 +0200
Subject: [PATCH] local: one message storage key, also after saving the erssi
 settings

Login and autoconnect derive the key of the encrypted message storage from
the fe-web password with a fixed salt. Saving the erssi connection in the
settings derived it from the Nexus password and the fe-web password
instead, so a storage opened again later in the same process (sign out and
in) used a key the stored history was not written with. The settings
handler now uses the same derivation.
---
 server/server.ts | 27 +++++++++++----------------
 1 file changed, 11 insertions(+), 16 deletions(-)

diff --git a/server/server.ts b/server/server.ts
index a7cd28b..c331913 100644
--- a/server/server.ts
+++ b/server/server.ts
@@ -1070,22 +1070,17 @@ function initializeIrssiClient(
 				client.config.irssiConnection.port
 			);
 
-			// Derive message storage encryption key (only if userPassword is available)
-			if (client.userPassword) {
-				client.encryptionKey = crypto.pbkdf2Sync(
-					client.userPassword,
-					client.irssiPassword,
-					10000,
-					32,
-					"sha256"
-				);
-
-				log.info(`Encryption keys re-derived for user ${client.name}`);
-			} else {
-				log.warn(
-					`Cannot re-derive encryption key for user ${client.name}: userPassword not available (session-based login)`
-				);
-			}
+			// Message storage key: the same derivation as login() and autoconnect
+			// (fe-web password, fixed salt). This used userPassword + irssiPassword,
+			// a different key than the one the stored history was written with.
+			client.encryptionKey = crypto.pbkdf2Sync(
+				client.irssiPassword,
+				"irssi-message-storage-v1",
+				10000,
+				32,
+				"sha256"
+			);
+			log.info(`Encryption key re-derived for user ${client.name}`);
 
 			// Reconnect to irssi with new settings
 			if (client.irssiConnection) {
