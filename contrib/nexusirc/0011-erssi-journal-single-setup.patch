From 280a95c3463ade035fca63051939f7c5d3c32bfc Mon Sep 17 00:00:00 2001
From: yooz <136268860+y-o-o-z@users.noreply.github.com>
Date: Fri, 2 Oct 2026 18:29:03 +0200
Subject: [PATCH 11/11] local: erssi journal setup cannot run twice at the same
 time

A late start (first network after Nexus) and init could overlap: the older
setup could start an orphaned tail (lines reported twice) or init could
broadcast networks without the erssi group. A generation counter makes a
superseded setup back off, and init blocks the late start while it runs.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 server/irssiClient.ts | 25 ++++++++++++++++++++++++-
 1 file changed, 24 insertions(+), 1 deletion(-)

diff --git a/server/irssiClient.ts b/server/irssiClient.ts
index 1bb5623a..deb232f4 100644
--- a/server/irssiClient.ts
+++ b/server/irssiClient.ts
@@ -269,6 +269,7 @@ export class IrssiClient {
 	private journalNetwork: NetworkData | null = null;
 	private journalBackfilled = new Set<string>();
 	private journalStarting = false;
+	private journalGeneration = 0; // a newer setup or a stop supersedes a running one
 
 	// Message deduplication cache
 	private messageDedup = new MessageDeduplicator();
@@ -2249,6 +2250,8 @@ export class IrssiClient {
 	 */
 	private async setupErssiJournal(networks: NetworkData[]): Promise<NetworkData | null> {
 		this.stopErssiJournal();
+		const generation = this.journalGeneration;
+		const superseded = () => generation !== this.journalGeneration;
 		const dir = journalDir();
 
 		if (!this.messageStorage || !fs.existsSync(dir)) {
@@ -2261,6 +2264,11 @@ export class IrssiClient {
 		await tail.prime();
 
 		const windows = await this.buildJournalNetwork(dir, networks);
+
+		if (superseded()) {
+			return null;
+		}
+
 		this.journalNetwork = windows;
 		// set before the backfill: channels joining meanwhile backfill
 		// themselves (handleChannelJoin), the backfilled set prevents doubles
@@ -2273,6 +2281,11 @@ export class IrssiClient {
 		}
 
 		await this.messageStorage.flush();
+
+		if (superseded()) {
+			return null;
+		}
+
 		tail.start();
 		logger.info(
 			`[IrssiClient] erssi journal: ${dir}, ${windows.channels.length - 1} erssi windows`
@@ -2321,6 +2334,7 @@ export class IrssiClient {
 	}
 
 	private stopErssiJournal(): void {
+		this.journalGeneration++;
 		this.journalTail?.stop();
 		this.journalTail = null;
 		this.journalNetwork = null;
@@ -2863,7 +2877,16 @@ export class IrssiClient {
 
 		// erssi journal: fill storage gaps and add the "erssi" window group
 		// before messages are loaded below.
-		const journalNetwork = await this.setupErssiJournal(networks);
+		// (marked as starting, so a network arriving meanwhile does not start
+		// a second, competing setup through startErssiJournalLate)
+		this.journalStarting = true;
+		let journalNetwork: NetworkData | null = null;
+
+		try {
+			journalNetwork = await this.setupErssiJournal(networks);
+		} finally {
+			this.journalStarting = false;
+		}
 
 		if (journalNetwork) {
 			networks = [journalNetwork, ...networks];
-- 
