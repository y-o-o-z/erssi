From 99406cd5233913cb0264ee1d272e5e2982673faf Mon Sep 17 00:00:00 2001
From: yooz <136268860+y-o-o-z@users.noreply.github.com>
Date: Fri, 2 Oct 2026 08:49:58 +0200
Subject: [PATCH] local: populate Recent mentions for irssi/erssi users
 (mentions:get/dismiss/dismiss_all)

---
 server/irssiClient.ts | 17 +++++++++++++++++
 server/server.ts      | 17 +++++++++++++++++
 2 files changed, 34 insertions(+)

diff --git a/server/irssiClient.ts b/server/irssiClient.ts
index dfa253e..9d48311 100644
--- a/server/irssiClient.ts
+++ b/server/irssiClient.ts
@@ -2240,6 +2240,23 @@ export class IrssiClient {
 				? msg.text.toLowerCase().includes(network.nick.toLowerCase())
 				: false;
 
+		// Remember the mention for the "Recent mentions" popup (mentions:get).
+		// Kept in memory like The Lounge does, capped to the newest 100.
+		if (isHighlight && !msg.self && channel) {
+			this.mentions.push({
+				chanId: channelId,
+				msgId: msg.id,
+				type: msg.type,
+				time: msg.time,
+				text: msg.text,
+				from: msg.from,
+			});
+
+			if (this.mentions.length > 100) {
+				this.mentions.splice(0, this.mentions.length - 100);
+			}
+		}
+
 		// Check if channel is open in any browser OR active in irssi
 		// If channel is open anywhere (browser or irssi), treat as read for ALL clients
 		const isChannelOpenInBrowser = this.isChannelOpenInAnyBrowser(channelId);
diff --git a/server/server.ts b/server/server.ts
index 5ca25e5..26871b1 100644
--- a/server/server.ts
+++ b/server/server.ts
@@ -804,6 +804,23 @@ function initializeIrssiClient(
 	});
 
 	// Handle mark_read request (mark channel as read in irssi)
+	// "Recent mentions" popup (client/components/Mentions.vue)
+	socket.on("mentions:get", () => {
+		socket.emit("mentions:list", client.mentions);
+	});
+
+	socket.on("mentions:dismiss", (msgId) => {
+		if (typeof msgId !== "number") {
+			return;
+		}
+
+		client.mentions = client.mentions.filter((m) => m.msgId !== msgId);
+	});
+
+	socket.on("mentions:dismiss_all", () => {
+		client.mentions = [];
+	});
+
 	socket.on("mark_read", (data) => {
 		if (!_.isPlainObject(data) || typeof data.target !== "number") {
 			return;
-- 
