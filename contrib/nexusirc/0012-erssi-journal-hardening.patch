+/** Bytes of `file` from `start` to `end` (or its end); empty if it is gone. */
+async function readRange(file: string, start: number, end?: number): Promise<Buffer> {
+	let handle: fs.promises.FileHandle;
+
+	try {
+		handle = await fs.promises.open(file, "r");
+	} catch {
+		return Buffer.alloc(0);
+	}
+
+	try {
+		const stop = end ?? (await handle.stat()).size;
+
+		if (stop <= start) {
+			return Buffer.alloc(0);
+		}
+
+		const buffer = Buffer.alloc(stop - start);
+		const {bytesRead} = await handle.read(buffer, 0, buffer.length, start);
+		return buffer.subarray(0, bytesRead);
+	} finally {
+		await handle.close();
+	}
+}
