From 640a3294401d37f63667ee24ae3c9d6e00ade0b2 Mon Sep 17 00:00:00 2001
From: yooz <136268860+y-o-o-z@users.noreply.github.com>
Date: Fri, 2 Oct 2026 18:08:46 +0200
Subject: [PATCH] local: erssi journal shows client and script lines of channel
 windows live

fe-web carries messages only, so lines that erssi scripts print in a channel
window never reached the web - with rpe2e.pl that hid E2E prompts such as a
key exchange request waiting for /e2e accept. webjournal.pl 1.1.0 journals
them as text entries of the channel; the tail now follows channel files and
reports those entries. prime() reads only the end of each file.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 server/erssiJournal.ts     | 76 +++++++++++++++++++++++++-------------
 server/irssiClient.ts      | 19 ++++++++--
 test/tests/erssiJournal.ts | 12 +++++-
 3 files changed, 77 insertions(+), 30 deletions(-)

diff --git a/server/erssiJournal.ts b/server/erssiJournal.ts
index 1c2c894e..e7988ff3 100644
--- a/server/erssiJournal.ts
+++ b/server/erssiJournal.ts
@@ -10,7 +10,9 @@
  *
  *  - backfill: journal entries of a channel/query that storage does not have
  *    yet (matched by kind + nick + text within a few seconds),
- *  - live tail: lines of text windows and network status windows.
+ *  - live tail: lines of text windows and network status windows, plus
+ *    client/script lines (k "text", e.g. "[E2E] ...") of channel windows -
+ *    the messages themselves come live through fe-web.
  *
  * Layout (the encoding must match webjournal.pl encode_name()):
  *   <tag>/<channel|nick>.jsonl, <tag>/%status.jsonl, %windows/<window>.jsonl
@@ -295,12 +297,34 @@ export function dedupSince(entries: JournalEntry[], now = Date.now()): number |
 
 export type TailEvent =
 	| {kind: "window"; key: string; entry: JournalEntry}
-	| {kind: "status"; key: string; entry: JournalEntry};
+	| {kind: "status"; key: string; entry: JournalEntry}
+	| {kind: "target"; key: string; name: string; entry: JournalEntry};
+
+/** Time of the last entry, read from the end of the file only. */
+async function lastEntryMs(file: string): Promise<number> {
+	const handle = await fs.promises.open(file, "r");
+
+	try {
+		const {size} = await handle.stat();
+		const length = Math.min(size, 64 * 1024);
+		const buffer = Buffer.alloc(length);
+		await handle.read(buffer, 0, length, size - length);
+		const entries = buffer
+			.toString("utf8")
+			.split("\n")
+			.map(parseEntry)
+			.filter((e): e is JournalEntry => e !== null);
+		return entries.length ? makeMonotonic(entries) : 0;
+	} finally {
+		await handle.close();
+	}
+}
 
 /**
- * Follows the files that only the journal carries: %windows/*.jsonl and
- * <tag>/%status.jsonl. Polling keeps it simple and works on every
- * filesystem; a shrunken file means webjournal.pl rotated it.
+ * Follows the journal: every line of %windows/*.jsonl and
+ * <tag>/%status.jsonl, and the text lines of channel/query files. Polling
+ * keeps it simple and works on every filesystem; a shrunken file means
+ * webjournal.pl rotated it.
  */
 export class JournalTail {
 	private offsets = new Map<string, number>();
@@ -322,12 +346,8 @@ export class JournalTail {
 	async prime(): Promise<void> {
 		for (const file of await this.files()) {
 			try {
-				const entries = await readEntries(file);
 				this.offsets.set(file, (await fs.promises.stat(file)).size);
-				this.lastMs.set(
-					file,
-					entries.length ? Math.round(entries[entries.length - 1].t * 1000) : 0
-				);
+				this.lastMs.set(file, await lastEntryMs(file));
 			} catch {
 				// vanished in the meantime
 			}
@@ -385,18 +405,14 @@ export class JournalTail {
 
 			const sub = path.join(this.dir, dirent.name);
 
-			if (dirent.name === WINDOWS_DIR) {
-				try {
-					for (const name of await fs.promises.readdir(sub)) {
-						if (name.endsWith(".jsonl")) {
-							found.push(path.join(sub, name));
-						}
+			try {
+				for (const name of await fs.promises.readdir(sub)) {
+					if (name.endsWith(".jsonl")) {
+						found.push(path.join(sub, name));
 					}
-				} catch {
-					// ignore
 				}
-			} else if (fs.existsSync(path.join(sub, STATUS_FILE))) {
-				found.push(path.join(sub, STATUS_FILE));
+			} catch {
+				// ignore
 			}
 		}
 
@@ -439,15 +455,25 @@ export class JournalTail {
 			this.partial.set(file, data.subarray(end + 1));
 			const lines = end === -1 ? [] : data.subarray(0, end).toString("utf8").split("\n");
 
-			const parentName = path.basename(path.dirname(file));
-			const kind = parentName === WINDOWS_DIR ? "window" : "status";
-			const key = kind === "window" ? path.basename(file, ".jsonl") : parentName;
-
 			const entries = lines.map(parseEntry).filter((e): e is JournalEntry => e !== null);
 			this.lastMs.set(file, makeMonotonic(entries, this.lastMs.get(file) ?? 0));
 
+			const dirName = path.basename(path.dirname(file));
+			const baseName = path.basename(file);
+
 			for (const entry of entries) {
-				this.onEvent({kind, key, entry});
+				if (dirName === WINDOWS_DIR) {
+					this.onEvent({kind: "window", key: path.basename(file, ".jsonl"), entry});
+				} else if (baseName === STATUS_FILE) {
+					this.onEvent({kind: "status", key: dirName, entry});
+				} else if (entry.k === "text") {
+					this.onEvent({
+						kind: "target",
+						key: dirName,
+						name: path.basename(file, ".jsonl"),
+						entry,
+					});
+				}
 			}
 		} finally {
 			await handle.close();
diff --git a/server/irssiClient.ts b/server/irssiClient.ts
index 946e2e85..7c5a4c79 100644
--- a/server/irssiClient.ts
+++ b/server/irssiClient.ts
@@ -2404,7 +2404,7 @@ export class IrssiClient {
 		}
 	}
 
-	/** New line in a text window or a network status window. */
+	/** New journal line: text window, network status window or client line of a channel. */
 	private handleJournalEvent(event: TailEvent): void {
 		const msg = entryToMsg(event.entry);
 
@@ -2446,10 +2446,21 @@ export class IrssiClient {
 		const network = this.networks.find(
 			(n) => n !== this.journalNetwork && encodeName(n.serverTag) === event.key
 		);
-		const lobby = network?.channels.find((c) => c.type === ChanType.LOBBY);
 
-		if (network && lobby) {
-			this.handleMessage(network.uuid, lobby.id, msg);
+		if (!network) {
+			return;
+		}
+
+		// status window -> lobby; a client/script line -> that channel/query
+		const channel =
+			event.kind === "status"
+				? network.channels.find((c) => c.type === ChanType.LOBBY)
+				: network.channels.find(
+						(c) => c.type !== ChanType.LOBBY && encodeName(c.name) === event.name
+					);
+
+		if (channel) {
+			this.handleMessage(network.uuid, channel.id, msg);
 		}
 	}
 
