+// erssi@tahio: this web client is NexusIRC with the erssi patch series
+// (y-o-o-z/erssi contrib/nexusirc), updated together with erssi by whoever
+// runs it. The upstream check asked The Lounge's GitHub releases - another
+// project - so it announced "updates" that must not be installed, and its
+// changelog was empty. The changelog is now the list of local patches in
+// this checkout (commits "local: ..." on top of NexusIRC), and nothing is
+// fetched from the network.
+
+const run = promisify(execFile);
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "../..");
+
+type Patch = {sha: string; date: string; subject: string; summary: string};
+
+let versions: SharedChangelogData | null = null;
+
+const escape = (s: string) =>
+	s.replace(
+		/[&<>"']/g,
+		(c) => ({"&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;"})[c]!
+	);
+
+async function localPatches(): Promise<Patch[]> {
+	const sep = "\x1f";
+	const end = "\x1e";
+	const {stdout} = await run(
+		"git",
+		[
+			"-C",
+			root,
+			"log",
+			"-n",
+			"200",
+			"--date=short",
+			`--format=%h${sep}%ad${sep}%s${sep}%b${end}`,
+		],
+		{maxBuffer: 4 * 1024 * 1024}
+	);
+	const patches: Patch[] = [];
+	for (const rec of stdout.split(end)) {
+		const [sha, date, subject, body] = rec.replace(/^\n/, "").split(sep);
+		if (!sha || !subject) {
+			continue;
+		}
+		// the series is on top: stop at the first upstream commit
+		if (!subject.startsWith("local:")) {
+			break;
+		}
+		const summary = (body || "")
+			.trim()
+			.split(/\n\s*\n/)[0]
+			.replace(/\s+/g, " ");
+		patches.push({sha, date, subject: subject.replace(/^local:\s*/, ""), summary});
+	}
+	return patches.reverse();
+}
 
