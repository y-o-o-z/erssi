+<style>
+/*
+ * Strona logowania erssi@tahio. Wlasne klasy (signin-*), zeby nie mieszac
+ * sie z ogolnymi regulami #sign-in z client/css/style.css. Kroje i znak
+ * slowny z themes/tahio/brand.css (zawsze ladowany w index.html.tpl), wiec wyglad
+ * nie zalezy od motywu wybranego w ustawieniach.
+ */
+
+/* Logowanie na calym ekranie - bez panelu kanalow. */
+#viewport:has(#sign-in) #sidebar,
+#viewport:has(#sign-in) #sidebar-overlay {
+	display: none;
+}
+
+#sign-in {
+	--si-cream: #f3ede1;
+	--si-paper: #fffdf8;
+	--si-line: #d6cbb6;
+	--si-ink: #1f2328;
+	--si-ink-soft: #57606a;
+	--si-muted: #6e7781;
+	--si-copper: #b25f10;
+	--si-copper-dark: #93500f;
+	--si-danger: #b42318;
+	--si-warn: #9a6700;
+
+	background: var(--si-cream);
+	color: var(--si-ink);
+	font-family: "Geist", system-ui, -apple-system, "Segoe UI", sans-serif;
+	-webkit-font-smoothing: antialiased;
+}
+
+#sign-in .signin {
+	box-sizing: border-box;
+	min-height: 100%;
+	display: grid;
+	grid-template-rows: auto 1fr auto;
+	gap: 32px;
+	padding: clamp(20px, 4vw, 44px) clamp(20px, 7vw, 96px);
+}
+
+#sign-in .signin-main {
+	display: flex;
+	align-items: center;
+	padding-left: clamp(0px, 9vw, 140px);
+}
+
+#sign-in .signin-form {
+	width: 100%;
+	max-width: 400px;
+}
+
+/* Linia w formacie IRC: nick!ident@host - nick uklada sie z pola. */
+#sign-in .signin-mask {
+	margin: 0 0 28px;
+	font-family: "Geist Mono", ui-monospace, monospace;
+	font-size: clamp(22px, 3.1vw, 34px);
+	font-weight: 500;
+	line-height: 1.25;
+	letter-spacing: -0.02em;
+	overflow-wrap: anywhere;
+}
+
+#sign-in .signin-mask-nick {
+	color: var(--si-ink);
+}
+
+#sign-in .signin-mask-nick.is-empty {
+	color: var(--si-line);
+}
+
+#sign-in .signin-mask-rest {
+	color: var(--si-muted);
+	font-weight: 400;
+}
+
+#sign-in .signin-caret {
+	display: inline-block;
+	width: 0.5ch;
+	height: 1em;
+	margin-left: 2px;
+	vertical-align: -0.12em;
+	background: var(--si-copper);
+	animation: signin-caret 1.1s steps(1) infinite;
+}
+
+@keyframes signin-caret {
+	50% {
+		opacity: 0;
+	}
+}
+
+#sign-in .signin-title {
+	margin: 0 0 24px;
+	font-size: 17px;
+	font-weight: 600;
+	line-height: 1.4;
+	color: var(--si-ink);
+}
+
+#sign-in .signin-field {
+	margin-bottom: 18px;
+}
+
+#sign-in .signin-field label {
+	display: block;
+	margin: 0 0 6px;
+	font-size: 14px;
+	font-weight: 500;
+	color: var(--si-ink-soft);
+}
+
+#sign-in .signin-input {
+	box-sizing: border-box;
+	width: 100%;
+	height: 44px;
+	margin: 0;
+	padding: 0 12px;
+	font: inherit;
+	font-size: 16px;
+	color: var(--si-ink);
+	background: var(--si-paper);
+	border: 1px solid var(--si-line);
+	border-radius: 6px;
+	transition: border-color 0.15s, box-shadow 0.15s;
+}
+
+#sign-in .signin-input:focus {
+	outline: none;
+	border-color: var(--si-copper);
+	box-shadow: 0 0 0 3px rgb(178 95 16 / 18%);
+}
+
+#sign-in .signin-input[aria-invalid="true"] {
+	border-color: var(--si-danger);
+}
+
+#sign-in .signin-password {
+	position: relative;
+}
+
+#sign-in .signin-password .signin-input {
+	padding-right: 76px;
+}
+
+#sign-in .signin-reveal {
+	position: absolute;
+	top: 6px;
+	right: 6px;
+	height: 32px;
+	padding: 0 10px;
+	font: inherit;
+	font-size: 13px;
+	font-weight: 500;
+	color: var(--si-copper-dark);
+	background: transparent;
+	border: 0;
+	border-radius: 4px;
+	cursor: pointer;
+}
+
+#sign-in .signin-reveal:hover {
+	background: rgb(178 95 16 / 8%);
+}
+
+#sign-in .signin-reveal:focus-visible,
+#sign-in .signin-submit:focus-visible {
+	outline: 2px solid var(--si-copper);
+	outline-offset: 2px;
+}
+
+#sign-in .signin-note {
+	margin: 6px 0 0;
+	font-size: 13px;
+	color: var(--si-warn);
+}
+
+#sign-in .signin-error {
+	margin: 4px 0 0;
+	font-size: 14px;
+	line-height: 1.45;
+	color: var(--si-danger);
+}
+
+#sign-in .signin-submit {
+	min-width: 160px;
+	height: 44px;
+	margin-top: 22px;
+	padding: 0 22px;
+	font: inherit;
+	font-size: 15px;
+	font-weight: 600;
+	color: var(--si-paper);
+	background: var(--si-copper);
+	border: 0;
+	border-radius: 6px;
+	cursor: pointer;
+	transition: background-color 0.15s;
+}
+
+#sign-in .signin-submit:hover {
+	background: var(--si-copper-dark);
+}
+
+#sign-in .signin-submit:disabled {
+	cursor: progress;
+	opacity: 0.75;
+}
+
+#sign-in .signin-foot {
+	font-size: 13px;
+	color: var(--si-muted);
+}
+
+@media (max-width: 600px) {
+	#sign-in .signin {
+		gap: 24px;
+	}
+
+	#sign-in .signin-main {
+		align-items: flex-start;
+		padding-left: 0;
+	}
+
+	#sign-in .signin-submit {
+		width: 100%;
+	}
+}
+
+@media (prefers-reduced-motion: reduce) {
+	#sign-in .signin-caret {
+		animation: none;
+	}
+
+	#sign-in .signin-input {
+		transition: none;
+	}
+}
+</style>
