+/*
+ * tahio — motyw erssi@tahio (NexusIRC) w tozsamosci tahio: miedz i krem.
+ *
+ * Paleta i kroje te same co w motywie shellter: krem
+ * #f3ede1, papier #fffdf8, miedz #b25f10, grafit #1f2328, Geist + Geist
+ * Mono (tahio/brand.css, ladowany zawsze w index.html.tpl). Jasny panel kanalow na
+ * kremie, okno rozmowy na papierze, aktywny kanal oznaczony miedzianym
+ * paskiem. Kolory nickow zostaja z bazowego arkusza (dobrane do jasnego tla).
+ */
+
+:root {
+	--tahio-cream: #f3ede1;
+	--tahio-paper: #fffdf8;
+	--tahio-line: #e8e0d0;
+	--tahio-line-strong: #d6cbb6;
+	--tahio-ink: #1f2328;
+	--tahio-ink-soft: #57606a;
+	--tahio-muted: #6e7781;
+	--tahio-copper: #b25f10;
+	--tahio-copper-dark: #93500f;
+	--tahio-copper-tint: #f6e8d6;
+	--tahio-danger: #b42318;
+	--tahio-warn: #9a6700;
+
+	/* zmienne bazowego arkusza (client/css/style.css) */
+	--body-color: var(--tahio-ink);
+	--body-color-muted: var(--tahio-muted);
+	--body-bg-color: var(--tahio-cream);
+	--button-color: var(--tahio-copper);
+	--button-text-color-hover: var(--tahio-paper);
+	--overlay-bg-color: rgb(31 35 40 / 35%);
+	--link-color: var(--tahio-copper-dark);
+	--window-bg-color: var(--tahio-paper);
+	--window-heading-color: var(--tahio-ink-soft);
+	--date-marker-color: rgb(110 119 129 / 55%);
+	--unread-marker-color: rgb(178 95 16 / 70%);
+	--highlight-bg-color: var(--tahio-copper-tint);
+	--highlight-border-color: var(--tahio-copper);
+	--upload-progressbar-color: var(--tahio-copper);
+}
+
+body,
+input,
+button,
+textarea,
+select {
+	font-family: "Geist", system-ui, -apple-system, "Segoe UI", sans-serif;
+}
+
+::selection {
+	background: rgb(178 95 16 / 22%);
+}
+
+/* ── panel kanalow ──────────────────────────────────────────────── */
+
+#sidebar {
+	background: var(--tahio-cream);
+	color: var(--tahio-ink-soft);
+	border-right: 1px solid var(--tahio-line);
+}
+
+#sidebar .logo-container {
+	padding: 18px 16px 10px;
+	text-align: left;
+}
+
+.channel-list-item {
+	color: var(--tahio-ink-soft);
+	border-radius: 0;
+}
+
+.channel-list-item:hover,
+#footer button:hover {
+	background-color: rgb(178 95 16 / 7%);
+}
+
+.channel-list-item.active {
+	background-color: var(--tahio-paper);
+	color: var(--tahio-ink);
+	box-shadow: inset 3px 0 0 var(--tahio-copper);
+}
+
+.channel-list-item[data-type="lobby"] {
+	color: var(--tahio-ink);
+	font-weight: 600;
+}
+
+.channel-list-item[data-type="lobby"].active {
+	color: var(--tahio-ink);
+}
+
+.channel-list-item.not-secure,
+.channel-list-item.not-secure.active {
+	color: var(--tahio-warn);
+}
+
+.channel-list-item.parted-channel,
+.channel-list-item.parted-channel.active {
+	color: var(--tahio-danger);
+}
+
+.channel-list-item .badge {
+	background: rgb(31 35 40 / 6%);
+	color: var(--tahio-ink-soft);
+}
+
+.channel-list-item .badge.highlight {
+	background: var(--tahio-copper);
+	color: var(--tahio-paper);
+}
+
+.channel-list-item .close::before,
+.channel-list-item[data-type="lobby"] .add-channel::before,
+#sidebar .network .collapse-network-icon::before {
+	color: var(--tahio-ink-soft);
+}
+
+#sidebar .empty {
+	color: var(--tahio-muted);
+}
+
+#footer {
+	border-top: 1px solid var(--tahio-line);
+}
+
+#footer button {
+	color: var(--tahio-muted);
+}
+
+.ui-sortable-dragging-touch-cue:not(.ui-sortable-dragging)::after {
+	border-color: var(--tahio-line-strong);
+}
+
+/* ── okno rozmowy ───────────────────────────────────────────────── */
+
+#chat .header,
+#windows .header {
+	border-bottom: 1px solid var(--tahio-line);
+}
+
+#chat .header .title {
+	font-weight: 600;
+}
+
+#chat .userlist {
+	border-left: 1px solid var(--tahio-line);
+	background: var(--tahio-paper);
+}
+
+#chat .time,
+#chat .msg .time {
+	font-family: "Geist Mono", ui-monospace, monospace;
+	font-variant-numeric: tabular-nums;
+	color: var(--tahio-muted);
+}
+
+#chat .chat-view[data-type="channel"] .msg.highlight {
+	background-color: var(--tahio-copper-tint);
+	border-left-color: var(--tahio-copper);
+}
+
+#form {
+	border-top: 1px solid var(--tahio-line);
+	background: var(--tahio-paper);
+}
+
+#form #nick {
+	background: var(--tahio-cream);
+	color: var(--tahio-ink-soft);
+}
+
+/* ── pola i przyciski ───────────────────────────────────────────── */
+
+.input {
+	background-color: var(--tahio-paper);
+	border: 1px solid var(--tahio-line-strong);
+	border-radius: 6px;
+	color: var(--tahio-ink);
+}
+
+.input:focus,
+#form #input:focus {
+	border-color: var(--tahio-copper);
+	box-shadow: 0 0 0 3px rgb(178 95 16 / 18%);
+	outline: none;
+}
+
+.btn {
+	border-color: var(--tahio-copper);
+	border-radius: 6px;
+	color: var(--tahio-copper-dark);
+}
+
+.btn:hover,
+.btn:focus-visible {
+	background-color: var(--tahio-copper);
+	border-color: var(--tahio-copper);
+	color: var(--tahio-paper);
+}
+
+:focus-visible {
+	outline: 2px solid var(--tahio-copper);
+	outline-offset: 2px;
+}
+
+#user-visible-error {
+	background: var(--tahio-danger);
+}
+
+/* ── ekran ladowania ────────────────────────────────────────────── */
+
+#loading {
+	background: var(--tahio-cream);
+	color: var(--tahio-ink-soft);
+}
