--- a/client/themes/shellter.css
+++ b/client/themes/shellter.css
@@ -4,8 +4,8 @@
  * Tokeny 1:1 z arkusza shellter.me: jasny (krem #faf8f4, karta #fdfbf8,
  * rdza #b45309) i ciemny (#0b0d10, #0e1116, bursztyn #f59e0b) - ten sam co
  * motyw shellter w terminalu erssi. Wariant wybiera system
- * (prefers-color-scheme), jak tryb "system" na shellter.me. Kroje Geist i
- * Geist Mono (shellter/brand.css, ladowany zawsze w index.html.tpl).
+ * (prefers-color-scheme), jak tryb "system" na shellter.me. Kroje "Source Sans 3" i
+ * Source Code Pro (shellter/brand.css, ladowany zawsze w index.html.tpl).
  * Znak trybu nicka w kolorze rangi (@ op, + voice, % halfop, ~ & wlasciciel),
  * tak samo jak $nickmode w terminalu.
  */
@@ -85,9 +85,35 @@ input,
 button,
 textarea,
 select {
-	font-family: Geist, system-ui, -apple-system, "Segoe UI", sans-serif;
+	font-family: "Source Sans 3", system-ui, -apple-system, "Segoe UI", sans-serif;
 }
 
+/* Source Sans 3 ma nizsze male litery niz kroje, dla ktorych bazowy arkusz
+   dobral 14px: 15px daje ta sama wielkosc oka co wczesniej. */
+#form,
+.messages .msg,
+.userlist,
+.channel-list-item,
+#sidebar .empty {
+	font-size: 15px;
+}
+/* Nicki na liscie osob czcionka stalej szerokosci, jak w terminalu: w kroju
+   proporcjonalnym "I" i "l" wygladaja prawie tak samo (124IA4IU3), a w
+   nickach IRC to rozne znaki. */
+#chat .userlist .user {
+	font-family: "Source Code Pro", ui-monospace, monospace;
+	font-size: 0.92em;
+}
+/* Bez ligatur w nickach, czasie i kodzie z IRC: kazdy znak ma byc widoczny
+   osobno (gdyby przegladarka podstawila krój zastepczy z ligaturami). */
+#chat .time,
+#chat .from,
+#chat .userlist .user,
+code,
+.irc-monospace,
+.erssi-wordmark {
+	font-variant-ligatures: none;
+}
 ::selection {
 	background: var(--sh-selection);
 }
@@ -217,13 +243,13 @@ select {
 
 #chat .time,
 #chat .msg .time {
-	font-family: "Geist Mono", ui-monospace, monospace;
+	font-family: "Source Code Pro", ui-monospace, monospace;
 	font-variant-numeric: tabular-nums;
 	color: var(--sh-fg-subtle);
 	white-space: nowrap;
 }
 
-/* Czas jak w terminalu, bez nawiasow; kolumna w znakach Geist Mono:
+/* Czas jak w terminalu, bez nawiasow; kolumna w znakach Source Code Pro:
    HH:MM, HH:MM:SS, HH:MM AM, HH:MM:SS AM (+1 na odstep). */
 #chat .time-bracket {
 	display: none;
@@ -244,12 +270,12 @@ select {
 
 /* Kolumna nadawcy na szerokosc najdluzszego nicka w oknie (--nick-col
    liczy MessageList, 4-16 znakow): krotkie nicki bez dziury po czasie,
-   dlugie dalej w jednej linii. Geist Mono, zeby 1ch = 1 znak nicka;
+   dlugie dalej w jednej linii. Source Code Pro, zeby 1ch = 1 znak nicka;
    +20px to padding kolumny z bazowego arkusza. Ponizej 480px kolumn nie ma. */
 @media (width >= 480px) {
 	#chat .from {
 		width: calc(var(--nick-col, 13ch) + 20px);
-		font-family: "Geist Mono", ui-monospace, monospace;
+		font-family: "Source Code Pro", ui-monospace, monospace;
 	}
 }
 
@@ -537,7 +563,7 @@ input[type="radio"] {
 
 code,
 .irc-monospace {
-	font-family: "Geist Mono", ui-monospace, monospace;
+	font-family: "Source Code Pro", ui-monospace, monospace;
 	color: var(--sh-primary-strong);
 	background-color: var(--sh-muted);
 	border-radius: 4px;
