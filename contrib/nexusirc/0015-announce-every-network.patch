From ab3d022539b56455edf45a144baf3c0fed0d506f Mon Sep 17 00:00:00 2001
From: yooz <136268860+y-o-o-z@users.noreply.github.com>
Date: Fri, 2 Oct 2026 19:44:52 +0200
Subject: [PATCH] local: announce every network the adapter creates

Networks reached IrssiClient only through server_status or state_dump.
A server that finished registering before Nexus attached to fe-web sent
neither, so its channels were tracked by the adapter but never reached
the browser ("ACTIVITY_UPDATE for unknown server"). The adapter now
reports each network it creates; fe-web only tags events with servers
erssi has, so a new network starts as connected.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 server/feWebClient/feWebAdapter.ts | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/server/feWebClient/feWebAdapter.ts b/server/feWebClient/feWebAdapter.ts
index eaa49d8e..bfac65e3 100644
--- a/server/feWebClient/feWebAdapter.ts
+++ b/server/feWebClient/feWebAdapter.ts
@@ -1046,7 +1046,9 @@ export class FeWebAdapter {
 				nick: "", // Will be set from state_dump or nick_change
 				serverTag: serverTag,
 				channels: [lobbyChannel], // Start with lobby channel
-				connected: false,
+				// fe-web only tags events with servers erssi has, so the
+				// server is live (server_status "disconnected" resets it)
+				connected: true,
 				serverOptions: {
 					CHANTYPES: ["#", "&", "!"], // Standard IRC channel types
 					PREFIX: new Prefix([
@@ -1069,6 +1071,12 @@ export class FeWebAdapter {
 					network.serverOptions
 				)}`
 			);
+
+			// Tell the client about every new network, not only those from
+			// server_status/state_dump: a server that finished registering
+			// before Nexus attached sends neither, and its channels would
+			// never reach the browser.
+			this.callbacks.onNetworkUpdate(network);
 		}
 
 		return network;
-- 
