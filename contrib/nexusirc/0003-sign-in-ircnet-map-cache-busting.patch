diff --git a/scripts/generate-ircnet-map.py b/scripts/generate-ircnet-map.py
new file mode 100644
index 00000000..1d63f788
--- /dev/null
+++ b/scripts/generate-ircnet-map.py
@@ -0,0 +1,116 @@
+#!/usr/bin/env python3
+"""Generuje ircnet-map.svg: Europa (Natural Earth 1:50m, domena publiczna) jako
+raster kropek + drzewo laczy serwerow w stylu IRCnetu z hubem w Warszawie."""
+import json, math
+import sys
+sys.setrecursionlimit(20000)
+
+W, H = 1000, 1100
+LON0, LAT0 = math.radians(14.0), math.radians(53.0)
+SCALE = 2050.0
+CX, CY = 470, 600          # gdzie na rysunku wypada srodek rzutu
+
+
+def laea(lon, lat):
+    l, p = math.radians(lon), math.radians(lat)
+    k = math.sqrt(2 / (1 + math.sin(LAT0) * math.sin(p) + math.cos(LAT0) * math.cos(p) * math.cos(l - LON0)))
+    x = k * math.cos(p) * math.sin(l - LON0)
+    y = k * (math.cos(LAT0) * math.sin(p) - math.sin(LAT0) * math.cos(p) * math.cos(l - LON0))
+    return CX + x * SCALE, CY - y * SCALE
+
+
+def simplify(pts, eps):
+    if len(pts) < 3:
+        return pts
+    (x1, y1), (x2, y2) = pts[0], pts[-1]
+    dx, dy = x2 - x1, y2 - y1
+    norm = math.hypot(dx, dy) or 1e-9
+    imax, dmax = 0, 0.0
+    for i in range(1, len(pts) - 1):
+        d = abs(dy * pts[i][0] - dx * pts[i][1] + x2 * y1 - y2 * x1) / norm
+        if d > dmax:
+            imax, dmax = i, d
+    if dmax > eps:
+        return simplify(pts[: imax + 1], eps)[:-1] + simplify(pts[imax:], eps)
+    return [pts[0], pts[-1]]
+
+
+# Dane: https://github.com/nvkelso/natural-earth-vector (geojson/ne_50m_land.geojson)
+import sys
+land = json.load(open(sys.argv[1] if len(sys.argv) > 1 else "ne_50m_land.geojson"))
+paths = []
+for feat in land["features"]:
+    geom = feat["geometry"]
+    polys = geom["coordinates"] if geom["type"] == "MultiPolygon" else [geom["coordinates"]]
+    for poly in polys:
+        for ring in poly:
+            if not any(-35 < lo < 60 and 30 < la < 75 for lo, la in ring):
+                continue
+            pts = [laea(lo, la) for lo, la in ring if -40 < lo < 70 and 25 < la < 80]
+            if len(pts) < 4:
+                continue
+            xs, ys = [p[0] for p in pts], [p[1] for p in pts]
+            if max(xs) < -50 or min(xs) > W + 50 or max(ys) < -50 or min(ys) > H + 50:
+                continue
+            # pierscien zamkniety (pierwszy == ostatni) upraszczamy jako dwie lamane
+            half = len(pts) // 2
+            pts = simplify(pts[: half + 1], 0.9)[:-1] + simplify(pts[half:], 0.9)
+            if len(pts) < 4:
+                continue
+            paths.append("M" + "L".join(f"{x:.1f} {y:.1f}" for x, y in pts) + "Z")
+
+# Wezly: miasta z serwerami IRC w Europie (ilustracja, nie mapa sieci 1:1).
+C = {
+    "waw": (21.01, 52.23), "gda": (18.65, 54.35), "poz": (16.93, 52.41), "wro": (17.04, 51.11),
+    "krk": (19.94, 50.06), "vno": (25.28, 54.69), "rix": (24.11, 56.95), "tll": (24.75, 59.44),
+    "hel": (24.94, 60.17), "sto": (18.07, 59.33), "osl": (10.75, 59.91), "cph": (12.57, 55.68),
+    "ams": (4.90, 52.37), "ens": (6.89, 52.22), "lon": (-0.13, 51.51), "par": (2.35, 48.86),
+    "bru": (4.35, 50.85), "fra": (8.68, 50.11), "zrh": (8.54, 47.37), "mil": (9.19, 45.46),
+    "rom": (12.50, 41.90), "vie": (16.37, 48.21), "prg": (14.42, 50.08), "bud": (19.04, 47.50),
+    "buh": (26.10, 44.43), "ber": (13.40, 52.52), "tmp": (23.76, 61.50), "oul": (25.47, 65.01),
+    "got": (11.97, 57.71), "lju": (14.51, 46.06), "mad": (-3.70, 40.42), "dub": (-6.26, 53.35),
+}
+EDGES = [
+    ("ams", "ens"), ("ams", "lon"), ("ams", "bru"), ("bru", "par"), ("lon", "dub"), ("par", "mad"),
+    ("ams", "fra"), ("fra", "zrh"), ("zrh", "mil"), ("mil", "rom"), ("fra", "prg"), ("prg", "vie"),
+    ("vie", "lju"), ("vie", "bud"), ("bud", "buh"), ("ams", "cph"), ("cph", "got"), ("got", "osl"),
+    ("cph", "sto"), ("sto", "hel"), ("hel", "tmp"), ("tmp", "oul"), ("hel", "tll"), ("tll", "rix"),
+    ("rix", "vno"), ("vno", "waw"), ("fra", "ber"), ("ber", "waw"), ("waw", "gda"), ("waw", "poz"),
+    ("waw", "wro"), ("waw", "krk"), ("sto", "gda"),
+]
+# Laczka, po ktorych biegna "pakiety" (kierunek: do Warszawy).
+PULSES = [("ber", "waw"), ("vno", "waw"), ("fra", "ber"), ("sto", "gda"), ("ams", "fra"), ("hel", "tll")]
+
+P = {k: laea(*v) for k, v in C.items()}
+
+
+def arc(a, b):
+    (x1, y1), (x2, y2) = P[a], P[b]
+    mx, my = (x1 + x2) / 2, (y1 + y2) / 2
+    dx, dy = x2 - x1, y2 - y1
+    bend = 0.16
+    return f"M{x1:.1f} {y1:.1f}Q{mx - dy * bend:.1f} {my + dx * bend:.1f} {x2:.1f} {y2:.1f}"
+
+
+hubs = {"ams", "fra", "sto", "hel", "waw"}
+out = [f'<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {W} {H}" preserveAspectRatio="xMidYMid slice" class="ircmap" aria-hidden="true" focusable="false">']
+out.append("""<defs>
+<pattern id="ircmap-dots" width="7" height="7" patternUnits="userSpaceOnUse"><circle cx="3.5" cy="3.5" r="1.45" class="ircmap-dot"/></pattern>
+<radialGradient id="ircmap-glow" cx="0.5" cy="0.5" r="0.5"><stop offset="0" class="ircmap-glow-in"/><stop offset="1" class="ircmap-glow-out"/></radialGradient>
+</defs>""")
+wx, wy = P["waw"]
+out.append(f'<circle cx="{wx:.1f}" cy="{wy:.1f}" r="330" fill="url(#ircmap-glow)"/>')
+out.append(f'<path class="ircmap-land" fill="url(#ircmap-dots)" fill-rule="evenodd" d="{"".join(paths)}"/>')
+out.append('<g class="ircmap-links">' + "".join(f'<path d="{arc(a, b)}"/>' for a, b in EDGES) + "</g>")
+out.append('<g class="ircmap-pulses">' + "".join(
+    f'<path d="{arc(a, b)}" pathLength="100" style="animation-delay:{i * -1.37:.2f}s"/>' for i, (a, b) in enumerate(PULSES)) + "</g>")
+out.append('<g class="ircmap-nodes">' + "".join(
+    f'<circle cx="{x:.1f}" cy="{y:.1f}" r="{4.2 if k in hubs else 2.6}"/>' for k, (x, y) in P.items() if k != "waw") + "</g>")
+out.append(f'<g class="ircmap-home"><circle class="ircmap-ring" cx="{wx:.1f}" cy="{wy:.1f}" r="15"/>'
+           f'<circle class="ircmap-ring ircmap-ring-2" cx="{wx:.1f}" cy="{wy:.1f}" r="15"/>'
+           f'<circle class="ircmap-core" cx="{wx:.1f}" cy="{wy:.1f}" r="6.5"/>'
+           f'<text x="{wx + 20:.1f}" y="{wy - 16:.1f}" class="ircmap-label">ircnet.pl</text></g>')
+out.append("</svg>")
+svg = "\n".join(out)
+open(sys.argv[2] if len(sys.argv) > 2 else "client/components/Windows/ircnet-map.svg", "w").write(svg)
+print(len(svg), "bajtow,", len(paths), "pierscieni ladu, Warszawa:", P["waw"])
