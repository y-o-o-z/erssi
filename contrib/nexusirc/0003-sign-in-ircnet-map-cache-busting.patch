+// Cache-busting from the content of the built client, not from the version
+// number: a local rebuild without a version bump must still produce new URLs,
+// otherwise a CDN in front (Cloudflare) keeps serving the previous bundle.
+let buildCacheBust: string | null = null;
+
+function getBuildCacheBust(): string {
+	if (buildCacheBust) {
+		return buildCacheBust;
+	}
+
+	const hash = crypto.createHash("sha256").update(Helper.getVersion());
+
+	try {
+		for (const file of ["js/bundle.js", "css/style.css"]) {
+			hash.update(fs.readFileSync(Utils.getFileFromRelativeToRoot("public", file)));
+		}
+	} catch (e: any) {
+		log.warn(`Cache-busting falls back to the version number: ${e.message}`);
+		return Helper.getVersionCacheBust();
+	}
+
+	buildCacheBust = hash.digest("hex").substring(0, 10);
+	return buildCacheBust;
+}
+
 function indexRequest(_req: Request, res: Response) {
 	res.setHeader("Content-Type", "text/html");
 
@@ -652,7 +678,7 @@ function indexRequest(_req: Request, res: Response) {
 
 		const config: IndexTemplateConfiguration = {
