@@ -104,6 +108,7 @@ import dayjs from "dayjs";
 
 import constants from "../js/constants";
 import localetime from "../js/helpers/localetime";
+import CLIENT_LINE from "../js/helpers/clientLine";
 import Username from "./Username.vue";
 import LinkPreview from "./LinkPreview.vue";
 import ParsedMessage from "./ParsedMessage.vue";
@@ -154,6 +159,22 @@ export default defineComponent({
 			return "message-" + (props.message.type || "invalid"); // TODO: force existence of type in sharedmsg
 		});
 
+		// erssi lines from the journal ("erssi │ #polska synced", "· │ Users on
+		// #tahio") carry their source in the text; it goes to the sender
+		// column, as in the terminal.
+		const clientLine = computed(() => {
+			if (props.message.type !== "message" || props.message.from?.nick) {
+				return null;
+			}
+
+			const match = CLIENT_LINE.exec(props.message.text || "");
+			return match ? {source: match[1], text: match[2]} : null;
+		});
+
+		const shownMessage = computed(() =>
+			clientLine.value ? {...props.message, text: clientLine.value.text} : props.message
+		);
+
 		const isAction = () => {
 			if (!props.message.type) {
 				return false;
@@ -168,6 +189,8 @@ export default defineComponent({
 			messageTimeLocale,
 			messageComponent,
 			isAction,
+			clientLine,
+			shownMessage,
 		};
 	},
 });
