diff --git a/client/js/viewport.ts b/client/js/viewport.ts
new file mode 100644
index 00000000..e1183b0d
--- /dev/null
+++ b/client/js/viewport.ts
@@ -0,0 +1,41 @@
+// Telefony: klawiatura ekranowa na iOS (i w Chrome na Androidzie bez
+// interactive-widget) nie zmniejsza strony, tylko ja przykrywa - linia
+// wpisywania znikala pod klawiatura albo pod paskiem przegladarki.
+// Wysokosc aplikacji = widoczna czesc okna, a przesuniecie strony, ktore
+// przegladarka robi przy otwieraniu klawiatury, jest cofane.
+export function trackVisualViewport(): void {
+	const vv = window.visualViewport;
+
+	if (!vv) {
+		return;
+	}
+
+	const root = document.documentElement;
+	let frame = 0;
+
+	const update = () => {
+		frame = 0;
+
+		// powiekszenie dwoma palcami tez zmniejsza visualViewport - wtedy nie ruszaj
+		if (Math.abs(vv.scale - 1) > 0.01) {
+			return;
+		}
+
+		root.style.setProperty("--app-height", `${Math.round(vv.height)}px`);
+
+		if (window.scrollY !== 0 || window.scrollX !== 0) {
+			window.scrollTo(0, 0);
+		}
+	};
+
+	const schedule = () => {
+		if (!frame) {
+			frame = requestAnimationFrame(update);
+		}
+	};
+
+	vv.addEventListener("resize", schedule);
+	vv.addEventListener("scroll", schedule);
+	window.addEventListener("orientationchange", schedule);
+	update();
+}
