From 16ef36cee4441ea1fa85e0acd6bcf93591e083fb Mon Sep 17 00:00:00 2001
From: y-o-o-z <136268860+y-o-o-z@users.noreply.github.com>
Date: Sat, 3 Oct 2026 13:14:16 +0200
Subject: [PATCH] local: phones - the input line stays above the keyboard

On a phone the input line was hidden or could not be used:
- iOS Safari (and Chrome on Android without interactive-widget) does not
  shrink the page for the on-screen keyboard, it covers it, and the page
  was 100% of the layout viewport - the input sat under the keyboard or
  the browser bar. The app now takes the height of the visible part
  (visualViewport, js/viewport.ts, kept while pinch-zoomed) and undoes the
  page scroll the browser makes when the keyboard opens; Chrome on Android
  resizes the page itself (interactive-widget=resizes-content), 100dvh
  otherwise.
- The input font was 15px on phones; iOS zooms the page into any field
  under 16px, pushing the input off screen. 16px now.
- Send and upload buttons were 22px; 40px on phones. The form keeps
  clear of the iPhone home indicator (safe-area-inset-bottom).
---
 client/css/style.css  | 40 ++++++++++++++++++++++++++++++++++++++++
 client/index.html.tpl |  2 +-
 client/js/viewport.ts | 41 +++++++++++++++++++++++++++++++++++++++++
 client/js/vue.ts      |  2 ++
 4 files changed, 84 insertions(+), 1 deletion(-)
 create mode 100644 client/js/viewport.ts

diff --git a/client/css/style.css b/client/css/style.css
index 4aca15d5..339c3cc0 100644
--- a/client/css/style.css
+++ b/client/css/style.css
@@ -2932,3 +2932,43 @@ part/quit messages where we don't load previews (adds a blank line otherwise) */
 	justify-content: center;
 	align-items: center;
 }
+
+/* Telefony: aplikacja ma wysokosc widocznej czesci okna (bez paska
+   przegladarki i klawiatury - js/viewport.ts), linia wpisywania nad paskiem
+   gestow iPhone'a */
+@supports (height: 100dvh) {
+	html,
+	body,
+	#app {
+		height: var(--app-height, 100dvh);
+	}
+}
+
+#form {
+	padding-bottom: calc(4px + env(safe-area-inset-bottom, 0px));
+}
+
+@media (max-width: 768px) {
+	/* 16px: przy mniejszej czcionce iOS powieksza strone po dotknieciu pola */
+	#form #input {
+		font-size: 16px;
+		line-height: 20px;
+		height: 20px;
+		min-height: 20px;
+		max-height: 100px;
+		margin: 6px 4px;
+	}
+
+	/* cel dla palca, nie dla kursora */
+	#form #upload,
+	#form #submit {
+		width: 40px;
+		height: 40px;
+		font-size: 16px;
+	}
+
+	#form {
+		padding: 2px 4px calc(2px + env(safe-area-inset-bottom, 0px));
+		align-items: center;
+	}
+}
