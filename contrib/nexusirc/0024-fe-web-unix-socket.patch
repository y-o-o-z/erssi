diff --git a/server/feWebClient/feWebPin.ts b/server/feWebClient/feWebPin.ts
index 4d4cd14..d45e05b 100644
--- a/server/feWebClient/feWebPin.ts
+++ b/server/feWebClient/feWebPin.ts
@@ -31,6 +31,36 @@ export function defaultCertFile(): string {
 	return path.join(os.homedir(), ".erssi", "fe-web-cert.pem");
 }
 
+/**
+ * erssi's Unix socket (its fe_web_socket setting), or undefined for TCP.
+ * "~/" is the home directory, a relative path is relative to ~/.erssi
+ * (as in erssi).
+ */
+export function feWebSocketPath(conn: {socketPath?: string}): string | undefined {
+	const value = String(conn.socketPath || "").trim();
+
+	if (!value) {
+		return undefined;
+	}
+
+	if (value === "~" || value.startsWith("~/")) {
+		return path.join(os.homedir(), value.slice(1));
+	}
+
+	return path.resolve(path.join(os.homedir(), ".erssi"), value);
+}
+
+/** erssi on this machine: over a Unix socket, or on a loopback address. */
+export function isLocalErssi(conn: {host: string; socketPath?: string}): boolean {
+	return feWebSocketPath(conn) !== undefined || isLocalHost(conn.host);
+}
+
+/** host:port, or unix:<path> for a Unix socket - for log lines. */
+export function feWebWhere(conn: {host: string; port: number; socketPath?: string}): string {
+	const socketPath = feWebSocketPath(conn);
+	return socketPath ? `unix:${socketPath}` : `${conn.host}:${conn.port}`;
+}
