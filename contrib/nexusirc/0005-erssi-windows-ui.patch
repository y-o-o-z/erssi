From d312b4e8b1d6500d0f473450b65c3452b0384449 Mon Sep 17 00:00:00 2001
From: yooz <136268860+y-o-o-z@users.noreply.github.com>
Date: Fri, 2 Oct 2026 17:44:53 +0200
Subject: [PATCH 5/6] local: erssi windows without close/join, journal text
 lines without sender column

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 client/components/NetworkList.vue | 8 ++++++++
 client/css/style.css              | 6 ++++++
 server/irssiClient.ts             | 1 +
 3 files changed, 15 insertions(+)

diff --git a/client/components/NetworkList.vue b/client/components/NetworkList.vue
index ef223dad..eedc5ece 100644
--- a/client/components/NetworkList.vue
+++ b/client/components/NetworkList.vue
@@ -80,6 +80,7 @@
 						'not-secure': !network.status.secure,
 					}"
 					class="network"
+					:data-uuid="network.uuid"
 					role="region"
 					aria-live="polite"
 					@touchstart="onDraggableTouchStart"
@@ -173,6 +174,13 @@
 	line-height: 35px !important;
 }
 
+/* erssi windows (Notices, Mentions, ...) mirror immortal erssi windows:
+   nothing to close or join there */
+.network[data-uuid="erssi-windows"] .channel-list-item .close,
+.network[data-uuid="erssi-windows"] .add-channel {
+	display: none;
+}
+
 .jump-to-results {
 	margin: 0;
 	padding: 0;
diff --git a/client/css/style.css b/client/css/style.css
index b37961b7..7e545fad 100644
--- a/client/css/style.css
+++ b/client/css/style.css
@@ -1373,6 +1373,12 @@ textarea.input {
 	padding: 0 10px;
 }
 
+/* Lines printed by erssi in a window without a channel (erssi journal)
+   have no sender - the text starts right after the time, as in erssi. */
+#chat .msg[data-type="message"]:not([data-from]) .from {
+	display: none;
+}
+
 #chat .time,
 #chat .from,
 #chat .content {
diff --git a/server/irssiClient.ts b/server/irssiClient.ts
index d8a62a30..946e2e85 100644
--- a/server/irssiClient.ts
+++ b/server/irssiClient.ts
@@ -1664,6 +1664,7 @@ export class IrssiClient {
 		}
 
 		this.attachedBrowsers.clear();
+		this.stopErssiJournal();
 
 		// Stop WeeChat Relay server
 		if (this.weechatRelayServer) {
-- 
