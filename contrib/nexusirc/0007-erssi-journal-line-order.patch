From: yooz <136268860+y-o-o-z@users.noreply.github.com>
Date: Fri, 2 Oct 2026 17:58:15 +0200
Subject: [PATCH 7/7] local: erssi journal keeps the order of lines printed in
 the same millisecond

Storage orders by whole milliseconds, so an fe-web error and its follow-up
line swapped places. Entry times of one journal file are made strictly
increasing (a tie becomes previous + 1 ms), in backfill and in the live tail.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 server/erssiJournal.ts     | 44 ++++++++++++++++++++++++++++++++------
 test/tests/erssiJournal.ts | 26 +++++++++++++++++++++-
 2 files changed, 63 insertions(+), 7 deletions(-)

diff --git a/server/erssiJournal.ts b/server/erssiJournal.ts
index aa5dced3..1c2c894e 100644
--- a/server/erssiJournal.ts
+++ b/server/erssiJournal.ts
@@ -109,6 +109,29 @@ export function parseEntry(line: string): JournalEntry | null {
 	}
 }
 
+/**
+ * Storage orders messages by time in whole milliseconds only, so lines that
+ * erssi printed in the same millisecond (an error and its follow-up) could
+ * swap places. Times of one file are made strictly increasing instead:
+ * a tie becomes the previous time plus 1 ms. Returns the last time used.
+ */
+export function makeMonotonic(entries: JournalEntry[], previousMs = 0): number {
+	let last = previousMs;
+
+	for (const entry of entries) {
+		let ms = Math.round(entry.t * 1000);
+
+		if (ms <= last) {
+			ms = last + 1;
+		}
+
+		entry.t = ms / 1000;
+		last = ms;
+	}
+
+	return last;
+}
+
 /** Entries of a journal file (rotated part first), oldest first. */
 export async function readEntries(file: string): Promise<JournalEntry[]> {
 	const entries: JournalEntry[] = [];
@@ -131,6 +154,7 @@ export async function readEntries(file: string): Promise<JournalEntry[]> {
 		}
 	}
 
+	makeMonotonic(entries);
 	return entries;
 }
 
@@ -281,6 +305,7 @@ export type TailEvent =
 export class JournalTail {
 	private offsets = new Map<string, number>();
 	private partial = new Map<string, Buffer>(); // bytes after the last newline
+	private lastMs = new Map<string, number>(); // last entry time per file (makeMonotonic)
 	private timer: ReturnType<typeof setInterval> | null = null;
 	private busy = false;
 
@@ -290,11 +315,19 @@ export class JournalTail {
 		private readonly intervalMs = 1000
 	) {}
 
-	/** Remember current file sizes: only lines written later are reported. */
+	/**
+	 * Remember current file sizes: only lines written later are reported.
+	 * The last entry's time continues the order readEntries() gave them.
+	 */
 	async prime(): Promise<void> {
 		for (const file of await this.files()) {
 			try {
+				const entries = await readEntries(file);
 				this.offsets.set(file, (await fs.promises.stat(file)).size);
+				this.lastMs.set(
+					file,
+					entries.length ? Math.round(entries[entries.length - 1].t * 1000) : 0
+				);
 			} catch {
 				// vanished in the meantime
 			}
@@ -410,12 +443,11 @@ export class JournalTail {
 			const kind = parentName === WINDOWS_DIR ? "window" : "status";
 			const key = kind === "window" ? path.basename(file, ".jsonl") : parentName;
 
-			for (const line of lines) {
-				const entry = parseEntry(line);
+			const entries = lines.map(parseEntry).filter((e): e is JournalEntry => e !== null);
+			this.lastMs.set(file, makeMonotonic(entries, this.lastMs.get(file) ?? 0));
 
-				if (entry) {
-					this.onEvent({kind, key, entry});
-				}
+			for (const entry of entries) {
+				this.onEvent({kind, key, entry});
 			}
 		} finally {
 			await handle.close();
