+<script lang="ts">
+import storage from "../../js/localStorage";
+import socket from "../../js/socket";
+import {defineComponent, nextTick, onBeforeUnmount, onMounted, ref} from "vue";
+import ircnetMap from "./ircnet-map.svg?raw";
+
+export default defineComponent({
+	name: "SignIn",
+	setup() {
+		const inFlight = ref(false);
+		const errorShown = ref(false);
+		const passwordVisible = ref(false);
+		const capsLock = ref(false);
+		const passwordInput = ref<HTMLInputElement | null>(null);
+
+		const username = ref(storage.get("user") || "");
+		const password = ref("");
+
+		const checkCapsLock = (event: KeyboardEvent) => {
+			if (typeof event.getModifierState === "function") {
+				capsLock.value = event.getModifierState("CapsLock");
+			}
+		};
+
+		const onAuthFailed = () => {
+			inFlight.value = false;
+			errorShown.value = true;
+
+			// Zle haslo: fokus z powrotem w polu hasla, tresc zaznaczona.
+			void nextTick(() => {
+				passwordInput.value?.focus();
+				passwordInput.value?.select();
+			});
+		};
+
+		const onSubmit = (event: Event) => {
+			event.preventDefault();
+
+			if (!username.value || !password.value) {
+				return;
+			}
+
+			inFlight.value = true;
+			errorShown.value = false;
+
+			const values = {
+				user: username.value,
+				password: password.value,
+			};
+
+			storage.set("user", values.user);
+
+			socket.emit("auth:perform", values);
+		};
+
+		onMounted(() => {
+			socket.on("auth:failed", onAuthFailed);
+		});
+
+		onBeforeUnmount(() => {
+			socket.off("auth:failed", onAuthFailed);
+		});
+
+		return {
+			inFlight,
+			errorShown,
+			passwordVisible,
+			capsLock,
+			passwordInput,
+			username,
+			password,
+			ircnetMap,
+			checkCapsLock,
+			onSubmit,
+		};
+	},
+});
+</script>
