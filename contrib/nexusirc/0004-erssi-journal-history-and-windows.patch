diff --git a/server/erssiJournal.ts b/server/erssiJournal.ts
new file mode 100644
index 00000000..aa5dced3
--- /dev/null
+++ b/server/erssiJournal.ts
@@ -0,0 +1,424 @@
+/**
+ * erssi journal - history written by webjournal.pl inside erssi.
+ *
+ * fe-web only streams events while NexusIRC is connected, so anything said
+ * while Nexus was down (restart, rebuild) never reached its storage, and
+ * windows without a channel (Notices, Mentions, script windows, the network
+ * status window) are not part of the fe-web protocol at all. webjournal.pl
+ * (https://github.com/y-o-o-z/irssi_scripts) writes every erssi window to
+ * JSON lines on disk; this module reads them back:
+ *
+ *  - backfill: journal entries of a channel/query that storage does not have
+ *    yet (matched by kind + nick + text within a few seconds),
+ *  - live tail: lines of text windows and network status windows.
+ *
+ * Layout (the encoding must match webjournal.pl encode_name()):
+ *   <tag>/<channel|nick>.jsonl, <tag>/%status.jsonl, %windows/<window>.jsonl
+ *   plus <file>.1 - the previous file after rotation.
+ */
+import fs from "fs";
+import os from "os";
+import path from "path";
+import Msg from "./models/msg.js";
+import User from "./models/user.js";
+import {MessageType} from "../shared/types/msg.js";
+
+export type JournalEntry = {
+	t: number; // unix time, seconds with a fraction
+	k: string; // msg action notice join part quit kick topic mode nick text
+	n?: string; // nick
+	h?: string; // user@host
+	x?: string; // text
+	s?: number; // 1 = own
+	hl?: number; // 1 = highlight
+	tg?: string; // kicked nick
+	nn?: string; // new nick
+	w?: string; // window name (text lines)
+};
+
+export const STATUS_FILE = "%status.jsonl";
+export const WINDOWS_DIR = "%windows";
+
+/** Entries further back than this are not backfilled. */
+export const BACKFILL_MAX_AGE_MS = 7 * 24 * 3600 * 1000;
+/** At most this many newest entries per window are considered. */
+export const BACKFILL_MAX_ENTRIES = 2000;
+/** Live fe-web events carry the time Nexus received them, not erssi's. */
+export const DEDUP_WINDOW_MS = 5000;
+
+export function journalDir(): string {
+	return process.env.ERSSI_JOURNAL_DIR || path.join(os.homedir(), ".erssi", "journal");
+}
+
+/** Lowercase ASCII, bytes outside [a-z0-9#&+!._-] as %XX - like webjournal.pl. */
+export function encodeName(name: string): string {
+	let out = "";
+
+	for (let byte of Buffer.from(name, "utf8")) {
+		if (byte >= 0x41 && byte <= 0x5a) {
+			byte += 0x20;
+		}
+
+		const char = String.fromCharCode(byte);
+
+		if (byte < 0x80 && /[a-z0-9#&+!._-]/.test(char)) {
+			out += char;
+		} else {
+			out += "%" + byte.toString(16).toUpperCase().padStart(2, "0");
+		}
+	}
+
+	return out;
+}
+
+export function decodeName(encoded: string): string {
+	try {
+		return decodeURIComponent(encoded);
+	} catch {
+		return encoded;
+	}
+}
+
+export function targetFile(dir: string, serverTag: string, target: string): string {
+	return path.join(dir, encodeName(serverTag), `${encodeName(target)}.jsonl`);
+}
+
+export function statusFile(dir: string, serverTag: string): string {
+	return path.join(dir, encodeName(serverTag), STATUS_FILE);
+}
+
+export function windowFile(dir: string, windowName: string): string {
+	return path.join(dir, WINDOWS_DIR, `${encodeName(windowName)}.jsonl`);
+}
+
+export function parseEntry(line: string): JournalEntry | null {
+	if (!line.trim()) {
+		return null;
+	}
+
+	try {
+		const entry = JSON.parse(line);
+
+		if (typeof entry?.t !== "number" || typeof entry?.k !== "string") {
+			return null;
+		}
+
+		return entry as JournalEntry;
+	} catch {
+		return null;
+	}
+}
+
+/** Entries of a journal file (rotated part first), oldest first. */
+export async function readEntries(file: string): Promise<JournalEntry[]> {
+	const entries: JournalEntry[] = [];
+
+	for (const part of [`${file}.1`, file]) {
+		let text: string;
+
+		try {
+			text = await fs.promises.readFile(part, "utf8");
+		} catch {
+			continue;
+		}
+
+		for (const line of text.split("\n")) {
+			const entry = parseEntry(line);
+
+			if (entry) {
+				entries.push(entry);
+			}
+		}
+	}
+
+	return entries;
+}
+
+/** NexusIRC message for a journal entry, shaped like the live fe-web ones. */
+export function entryToMsg(entry: JournalEntry): Msg | null {
+	const time = new Date(Math.round(entry.t * 1000));
+	const from = new User({nick: entry.n || ""});
+	const self = entry.s === 1;
+
+	switch (entry.k) {
+		case "msg":
+			return new Msg({
+				type: MessageType.MESSAGE,
+				time,
+				from,
+				text: entry.x || "",
+				self,
+				highlight: entry.hl === 1 && !self,
+			});
+		case "action":
+			return new Msg({
+				type: MessageType.ACTION,
+				time,
+				from,
+				text: entry.x || "",
+				self,
+				highlight: entry.hl === 1 && !self,
+			});
+		case "notice":
+			return new Msg({type: MessageType.NOTICE, time, from, text: entry.x || "", self});
+		case "join":
+			return new Msg({type: MessageType.JOIN, time, from, hostmask: entry.h || "", self});
+		case "part":
+			return new Msg({
+				type: MessageType.PART,
+				time,
+				from,
+				hostmask: entry.h || "",
+				text: entry.x || "",
+				self,
+			});
+		case "quit":
+			return new Msg({
+				type: MessageType.QUIT,
+				time,
+				from,
+				hostmask: entry.h || "",
+				text: entry.x || "",
+			});
+		case "kick":
+			return new Msg({
+				type: MessageType.KICK,
+				time,
+				from,
+				target: new User({nick: entry.tg || ""}),
+				text: entry.x || "",
+			});
+		case "topic":
+			return new Msg({type: MessageType.TOPIC, time, from, text: entry.x || ""});
+		case "mode":
+			return new Msg({type: MessageType.MODE_CHANNEL, time, from, text: entry.x || ""});
+		case "nick":
+			return new Msg({type: MessageType.NICK, time, from, new_nick: entry.nn || "", self});
+		case "text":
+			// A line exactly as erssi printed it in a window without a channel.
+			return new Msg({
+				type: MessageType.MESSAGE,
+				time,
+				text: entry.x || "",
+				highlight: entry.hl === 1,
+			});
+		default:
+			return null;
+	}
+}
+
+function signature(msg: Msg): string {
+	const nick = msg.from?.nick || "";
+	const extra =
+		msg.type === MessageType.NICK
+			? (msg as any).new_nick || ""
+			: msg.type === MessageType.KICK
+				? msg.target?.nick || ""
+				: "";
+	return `${msg.type}\u0000${nick.toLowerCase()}\u0000${msg.text || ""}\u0000${extra}`;
+}
+
+/**
+ * Messages from the journal that are not in storage yet. `stored` must hold
+ * the stored messages from the oldest candidate's time (minus the dedup
+ * window) on. A stored message matches one journal entry at most.
+ */
+export function missingMessages(entries: JournalEntry[], stored: Msg[], now = Date.now()): Msg[] {
+	const pool = new Map<string, number[]>();
+
+	for (const msg of stored) {
+		const key = signature(msg);
+		const times = pool.get(key) || [];
+		times.push(msg.time.getTime());
+		pool.set(key, times);
+	}
+
+	const missing: Msg[] = [];
+
+	for (const entry of candidates(entries, now)) {
+		const msg = entryToMsg(entry);
+
+		if (!msg) {
+			continue;
+		}
+
+		const times = pool.get(signature(msg));
+		const at = msg.time.getTime();
+		const hit = times ? times.findIndex((t) => Math.abs(t - at) <= DEDUP_WINDOW_MS) : -1;
+
+		if (hit !== -1) {
+			times!.splice(hit, 1);
+			continue;
+		}
+
+		missing.push(msg);
+	}
+
+	return missing;
+}
+
+/** Newest entries worth backfilling, oldest first. */
+export function candidates(entries: JournalEntry[], now = Date.now()): JournalEntry[] {
+	const oldest = now - BACKFILL_MAX_AGE_MS;
+	return entries.filter((e) => e.t * 1000 >= oldest).slice(-BACKFILL_MAX_ENTRIES);
+}
+
+/** Time from which stored messages are needed to deduplicate `entries`. */
+export function dedupSince(entries: JournalEntry[], now = Date.now()): number | null {
+	const list = candidates(entries, now);
+	return list.length ? Math.round(list[0].t * 1000) - DEDUP_WINDOW_MS : null;
+}
+
+export type TailEvent =
+	| {kind: "window"; key: string; entry: JournalEntry}
+	| {kind: "status"; key: string; entry: JournalEntry};
+
+/**
+ * Follows the files that only the journal carries: %windows/*.jsonl and
+ * <tag>/%status.jsonl. Polling keeps it simple and works on every
+ * filesystem; a shrunken file means webjournal.pl rotated it.
+ */
+export class JournalTail {
+	private offsets = new Map<string, number>();
+	private partial = new Map<string, Buffer>(); // bytes after the last newline
+	private timer: ReturnType<typeof setInterval> | null = null;
+	private busy = false;
+
+	constructor(
+		private readonly dir: string,
+		private readonly onEvent: (event: TailEvent) => void,
+		private readonly intervalMs = 1000
+	) {}
+
+	/** Remember current file sizes: only lines written later are reported. */
+	async prime(): Promise<void> {
+		for (const file of await this.files()) {
+			try {
+				this.offsets.set(file, (await fs.promises.stat(file)).size);
+			} catch {
+				// vanished in the meantime
+			}
+		}
+	}
+
+	start(): void {
+		if (this.timer) {
+			return;
+		}
+
+		this.timer = setInterval(() => {
+			void this.poll();
+		}, this.intervalMs);
+		this.timer.unref?.();
+	}
+
+	stop(): void {
+		if (this.timer) {
+			clearInterval(this.timer);
+			this.timer = null;
+		}
+	}
+
+	async poll(): Promise<void> {
+		if (this.busy) {
+			return;
+		}
+
+		this.busy = true;
+
+		try {
+			for (const file of await this.files()) {
+				await this.readNew(file);
+			}
+		} finally {
+			this.busy = false;
+		}
+	}
+
+	private async files(): Promise<string[]> {
+		const found: string[] = [];
+		let dirs: fs.Dirent[];
+
+		try {
+			dirs = await fs.promises.readdir(this.dir, {withFileTypes: true});
+		} catch {
+			return found;
+		}
+
+		for (const dirent of dirs) {
+			if (!dirent.isDirectory()) {
+				continue;
+			}
+
+			const sub = path.join(this.dir, dirent.name);
+
+			if (dirent.name === WINDOWS_DIR) {
+				try {
+					for (const name of await fs.promises.readdir(sub)) {
+						if (name.endsWith(".jsonl")) {
+							found.push(path.join(sub, name));
+						}
+					}
+				} catch {
+					// ignore
+				}
+			} else if (fs.existsSync(path.join(sub, STATUS_FILE))) {
+				found.push(path.join(sub, STATUS_FILE));
+			}
+		}
+
+		return found;
+	}
+
+	private async readNew(file: string): Promise<void> {
+		let size: number;
+
+		try {
+			size = (await fs.promises.stat(file)).size;
+		} catch {
+			return;
+		}
+
+		let offset = this.offsets.get(file) ?? 0;
+
+		if (size < offset) {
+			// rotated: the old content is in <file>.1, this one starts over
+			offset = 0;
+			this.partial.delete(file);
+		}
+
+		if (size === offset) {
+			this.offsets.set(file, offset);
+			return;
+		}
+
+		const handle = await fs.promises.open(file, "r");
+
+		try {
+			const buffer = Buffer.alloc(size - offset);
+			await handle.read(buffer, 0, buffer.length, offset);
+			this.offsets.set(file, size);
+
+			// Split on newline bytes, so a line caught mid-write (possibly in
+			// the middle of a UTF-8 sequence) waits for the next poll intact.
+			const data = Buffer.concat([this.partial.get(file) || Buffer.alloc(0), buffer]);
+			const end = data.lastIndexOf(0x0a);
+			this.partial.set(file, data.subarray(end + 1));
+			const lines = end === -1 ? [] : data.subarray(0, end).toString("utf8").split("\n");
+
+			const parentName = path.basename(path.dirname(file));
+			const kind = parentName === WINDOWS_DIR ? "window" : "status";
+			const key = kind === "window" ? path.basename(file, ".jsonl") : parentName;
+
+			for (const line of lines) {
+				const entry = parseEntry(line);
+
+				if (entry) {
+					this.onEvent({kind, key, entry});
+				}
+			}
+		} finally {
+			await handle.close();
+		}
+	}
