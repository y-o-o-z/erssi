diff --git a/client/themes/shellter.css b/client/themes/shellter.css
new file mode 100644
index 00000000..cc0ff110
--- /dev/null
+++ b/client/themes/shellter.css
@@ -0,0 +1,571 @@
+/*
+ * shellter - motyw erssi@tahio w barwach shellter.me ("Your shell, your shelter").
+ *
+ * Tokeny 1:1 z arkusza shellter.me: jasny (krem #faf8f4, karta #fdfbf8,
+ * rdza #b45309) i ciemny (#0b0d10, #0e1116, bursztyn #f59e0b) - ten sam co
+ * motyw shellter w terminalu erssi. Wariant wybiera system
+ * (prefers-color-scheme), jak tryb "system" na shellter.me. Kroje Geist i
+ * Geist Mono (shellter/brand.css, ladowany zawsze w index.html.tpl).
+ * Znak trybu nicka w kolorze rangi (@ op, + voice, % halfop, ~ & wlasciciel),
+ * tak samo jak $nickmode w terminalu.
+ */
+
+:root {
+	--sh-bg: #faf8f4;
+	--sh-card: #fdfbf8;
+	--sh-muted: #f3eee5;
+	--sh-line: #e8e1d3;
+	--sh-line-strong: #cfc4ad;
+	--sh-fg: #1d1714;
+	--sh-fg-muted: #5b4a36;
+	--sh-fg-subtle: #8a7960;
+	--sh-primary: #b45309;
+	--sh-primary-strong: #92400e;
+	--sh-primary-soft: rgb(180 83 9 / 8%);
+	--sh-primary-tint: #f6e9d6;
+	--sh-on-primary: #faf8f4;
+	--sh-selection: rgb(180 83 9 / 20%);
+	--sh-focus: rgb(180 83 9 / 22%);
+	--sh-danger: #b42318;
+	--sh-warn: #9a6700;
+	--sh-mode-owner: #b42318;
+	--sh-mode-op: #b45309;
+	--sh-mode-halfop: #15803d;
+	--sh-mode-voice: #1d4ed8;
+	--sh-overlay: rgb(29 23 20 / 35%);
+
+	/* zmienne bazowego arkusza (client/css/style.css) */
+	--body-color: var(--sh-fg);
+	--body-color-muted: var(--sh-fg-subtle);
+	--body-bg-color: var(--sh-bg);
+	--button-color: var(--sh-primary);
+	--button-text-color-hover: var(--sh-on-primary);
+	--overlay-bg-color: var(--sh-overlay);
+	--link-color: var(--sh-primary-strong);
+	--window-bg-color: var(--sh-card);
+	--window-heading-color: var(--sh-fg-muted);
+	--date-marker-color: var(--sh-fg-subtle);
+	--unread-marker-color: var(--sh-primary);
+	--highlight-bg-color: var(--sh-primary-tint);
+	--highlight-border-color: var(--sh-primary);
+	--upload-progressbar-color: var(--sh-primary);
+}
+
+@media (prefers-color-scheme: dark) {
+	:root {
+		--sh-bg: #0b0d10;
+		--sh-card: #0e1116;
+		--sh-muted: #161b22;
+		--sh-line: #1f2428;
+		--sh-line-strong: #30363d;
+		--sh-fg: #e6edf3;
+		--sh-fg-muted: #7d8590;
+		--sh-fg-subtle: #6e7681;
+		--sh-primary: #f59e0b;
+		--sh-primary-strong: #fcd34d;
+		--sh-primary-soft: rgb(245 158 11 / 8%);
+		--sh-primary-tint: rgb(245 158 11 / 12%);
+		--sh-on-primary: #0b0d10;
+		--sh-selection: rgb(245 158 11 / 25%);
+		--sh-focus: rgb(245 158 11 / 25%);
+		--sh-danger: #ff7b72;
+		--sh-warn: #fcd34d;
+		--sh-mode-owner: #ff7b72;
+		--sh-mode-op: #f59e0b;
+		--sh-mode-halfop: #3fb950;
+		--sh-mode-voice: #79c0ff;
+		--sh-overlay: rgb(0 0 0 / 50%);
+
+		color-scheme: dark;
+	}
+}
+
+body,
+input,
+button,
+textarea,
+select {
+	font-family: Geist, system-ui, -apple-system, "Segoe UI", sans-serif;
+}
+
+::selection {
+	background: var(--sh-selection);
+}
+
+/* ── panel kanalow ──────────────────────────────────────────────── */
+
+#sidebar {
+	background: var(--sh-bg);
+	color: var(--sh-fg-muted);
+	border-right: 1px solid var(--sh-line);
+}
+
+#sidebar .logo-container {
+	padding: 18px 16px 10px;
+	text-align: left;
+}
+
+.channel-list-item {
+	color: var(--sh-fg-muted);
+	border-radius: 0;
+}
+
+.channel-list-item:hover,
+#footer button:hover {
+	background-color: var(--sh-primary-soft);
+}
+
+.channel-list-item.active {
+	background-color: var(--sh-card);
+	color: var(--sh-fg);
+	box-shadow: inset 3px 0 0 var(--sh-primary);
+}
+
+.channel-list-item[data-type="lobby"] {
+	color: var(--sh-fg);
+	font-weight: 600;
+}
+
+.channel-list-item[data-type="lobby"].active {
+	color: var(--sh-fg);
+}
+
+.channel-list-item.not-secure,
+.channel-list-item.not-secure.active {
+	color: var(--sh-warn);
+}
+
+.channel-list-item.parted-channel,
+.channel-list-item.parted-channel.active {
+	color: var(--sh-danger);
+}
+
+.channel-list-item .badge {
+	background: var(--sh-muted);
+	color: var(--sh-fg-muted);
+}
+
+.channel-list-item .badge.highlight {
+	background: var(--sh-primary);
+	color: var(--sh-card);
+}
+
+.channel-list-item .close::before,
+.channel-list-item[data-type="lobby"] .add-channel::before,
+#sidebar .network .collapse-network-icon::before {
+	color: var(--sh-fg-muted);
+}
+
+#sidebar .erssi-wordmark {
+	color: var(--sh-fg);
+}
+
+/* "Jump to..." - bazowy arkusz zaklada ciemny panel (bialy tekst) */
+.jump-to-input .input {
+	color: var(--sh-fg);
+	background-color: var(--sh-card);
+	border: 1px solid var(--sh-line);
+}
+
+.jump-to-input .input::placeholder,
+.jump-to-input::before {
+	color: var(--sh-fg-subtle);
+}
+
+#sidebar .empty {
+	color: var(--sh-fg-subtle);
+}
+
+#footer {
+	border-top: 1px solid var(--sh-line);
+}
+
+#footer button {
+	color: var(--sh-fg-subtle);
+}
+
+.ui-sortable-dragging-touch-cue:not(.ui-sortable-dragging)::after {
+	border-color: var(--sh-line-strong);
+}
+
+/* ── okno rozmowy ───────────────────────────────────────────────── */
+
+#chat .header,
+#windows .header {
+	border-bottom: 1px solid var(--sh-line);
+}
+
+#chat .header .title {
+	font-weight: 600;
+}
+
+#chat .userlist {
+	border-left: 1px solid var(--sh-line);
+	background: var(--sh-card);
+}
+
+#chat .time,
+#chat .msg .time {
+	font-family: "Geist Mono", ui-monospace, monospace;
+	font-variant-numeric: tabular-nums;
+	color: var(--sh-fg-subtle);
+	white-space: nowrap;
+}
+
+/* Kolumna czasu w znakach kroju Geist Mono (bazowe szerokosci w px sa
+   dobrane pod Hack): [HH:MM], [HH:MM:SS], [HH:MM AM], [HH:MM:SS AM]. */
+#chat .time {
+	width: 7ch;
+}
+
+#chat.time-12h .time,
+#chat.time-seconds .time {
+	width: 10ch;
+}
+
+#chat.time-seconds.time-12h .time {
+	width: 13ch;
+}
+
+#chat .chat-view[data-type="channel"] .msg.highlight {
+	background-color: var(--sh-primary-tint);
+	border-left-color: var(--sh-primary);
+}
+
+#form {
+	border-top: 1px solid var(--sh-line);
+	background: var(--sh-card);
+}
+
+#form #nick {
+	background: var(--sh-bg);
+	color: var(--sh-fg-muted);
+}
+
+/* ── pola i przyciski ───────────────────────────────────────────── */
+
+.input {
+	background-color: var(--sh-card);
+	border: 1px solid var(--sh-line-strong);
+	border-radius: 6px;
+	color: var(--sh-fg);
+}
+
+.input:focus,
+#form #input:focus {
+	border-color: var(--sh-primary);
+	box-shadow: 0 0 0 3px var(--sh-focus);
+	outline: none;
+}
+
+.btn {
+	border-color: var(--sh-primary);
+	border-radius: 6px;
+	color: var(--sh-primary-strong);
