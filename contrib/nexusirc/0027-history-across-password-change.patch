-				`${who}: cannot read the fe-web certificate ${conn.caFile} (${
+				`${who}: cannot read the fe-web certificate ${caFile} (${
 					(error as NodeJS.ErrnoException).code || String(error)
 				}) - not connecting to ${where}`
 			);
@@ -109,9 +175,58 @@ export function feWebTls(
 				`${who}: no fe-web certificate in ${file} - accepting any certificate from ${where}`
 			);
 		}
-	} else if (!conn.rejectUnauthorized) {
