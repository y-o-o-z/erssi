@@ -0,0 +1,55 @@
+import {expect} from "chai";
+
+import {IrssiClient, SESSION_MAX_IDLE_MS, expireSessions} from "../../dist/server/irssiClient.js";
+
+const NOW = 1790950000000;
+const DAY = 24 * 3600 * 1000;
+
+describe("browser sessions", function () {
+	const sessions = () => ({
+		fresh: {lastUse: NOW - DAY},
+		old: {lastUse: NOW - SESSION_MAX_IDLE_MS - DAY},
+		attachedOld: {lastUse: NOW - SESSION_MAX_IDLE_MS - 60 * DAY},
+		never: {} as {lastUse?: number},
+	});
+
+	it("drops sessions unused for 30 days", function () {
+		const s = sessions();
+		expect(expireSessions(s, new Set(), NOW)).to.equal(true);
+		expect(Object.keys(s)).to.deep.equal(["fresh"]);
+	});
+
+	it("keeps a session a browser is attached with, however old its lastUse", function () {
+		const s = sessions();
+		expect(expireSessions(s, new Set(["attachedOld"]), NOW)).to.equal(true);
+		expect(Object.keys(s).sort()).to.deep.equal(["attachedOld", "fresh"]);
+	});
+
+	it("reports nothing dropped", function () {
+		const s = {fresh: {lastUse: NOW}};
+		expect(expireSessions(s, new Set(), NOW)).to.equal(false);
+		expect(s).to.have.property("fresh");
+	});
+
+	it("uses the attached browsers of the client, and refreshes their sessions", function () {
+		const fake = {
