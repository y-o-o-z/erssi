+
+/**
+ * Logs a FeWebPinError of one connection: at error level the first time a
+ * message is seen, at debug level while it repeats (a reconnect every 30 s
+ * would otherwise log the same line every 30 s). reset() after a connection
+ * succeeded, so the next failure is reported again.
+ */
+export class PinErrorLog {
+	private last: string | null = null;
+
+	report(error: Error): "error" | "debug" {
+		if (error.message !== this.last) {
+			this.last = error.message;
+			log.error(error.message);
+			return "error";
+		}
+
+		log.debug(error.message);
+		return "debug";
+	}
+
+	reset() {
+		this.last = null;
+	}
+}
