+	const ip = name.replace(/%.*$/, ""); // fe80::1%eth0
+	const family = net.isIPv4(ip) ? "ipv4" : net.isIPv6(ip) ? "ipv6" : null;
+
+	if (!family) {
+		return false;
+	}
+
+	if (loopback.check(ip, family)) {
