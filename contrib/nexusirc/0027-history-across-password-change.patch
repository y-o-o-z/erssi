+		if (fs.existsSync(file)) {
+			warnOnce(
+				`${who}|${where}`,
+				`${who}: ${where} is not recognised as this machine, so the fe-web certificate in ${file} is not used; if this erssi runs here, use host 127.0.0.1 (or socketPath), or set caFile to pin it`
+			);
+		}
+
+		if (!conn.rejectUnauthorized) {
