+/**
+ * Key of the encrypted message storage: from the fe-web password with a
+ * fixed salt (login, autoconnect and the settings page alike).
+ */
+export function deriveStorageKey(irssiPassword: string): Buffer {
+	return crypto.pbkdf2Sync(irssiPassword, "irssi-message-storage-v1", 10000, 32, "sha256");
+}
+
+/** Sessions unused for this long are dropped. */
+export const SESSION_MAX_IDLE_MS = 30 * 24 * 3600 * 1000;
+
+/**
+ * Deletes from `sessions` the ones unused for SESSION_MAX_IDLE_MS, except
+ * those in `attached` (token hashes of the browsers attached now); true
+ * when any was deleted.
+ */
+export function expireSessions(
+	sessions: Record<string, {lastUse?: number}>,
+	attached: ReadonlySet<string>,
+	now = Date.now()
+): boolean {
+	const expiry = now - SESSION_MAX_IDLE_MS;
+	let expired = false;
+
+	for (const [hash, session] of Object.entries(sessions)) {
+		if (!attached.has(hash) && (session?.lastUse || 0) < expiry) {
+			delete sessions[hash];
+			expired = true;
+		}
+	}
+
+	return expired;
+}
