diff --git a/test/plugins/encryptedStorage.ts b/test/plugins/encryptedStorage.ts
new file mode 100644
index 0000000..af325bc
--- /dev/null
+++ b/test/plugins/encryptedStorage.ts
@@ -0,0 +1,196 @@
+import {expect} from "chai";
+import crypto from "crypto";
+import fs from "fs";
+import os from "os";
+import path from "path";
+import sinon from "sinon";
+
+import {log} from "../../dist/server/logger.js";
+import Msg from "../../dist/server/models/msg.js";
+import User from "../../dist/server/models/user.js";
+import {IrssiClient} from "../../dist/server/irssiClient.js";
+import {EncryptedMessageStorage} from "../../dist/server/plugins/messageStorage/encrypted.js";
+
+const network = {uuid: "a6b5e0b2-0d4b-4a6e-9a1f-5c7c4d7a0f11"} as any;
+const channel = {name: "#Polska"} as any;
+const key = () => crypto.randomBytes(32);
+
+describe("Encrypted message storage", function () {
+	let dir: string;
+	let file: string;
+	let stubs: sinon.SinonStub[];
+
+	const open = async (k: Buffer) => {
+		const storage = new EncryptedMessageStorage("test", k);
+		await storage._enable(file);
+		storage.initDone.resolve();
+		return storage;
+	};
+
+	const say = (storage: EncryptedMessageStorage, text: string, at: number) =>
+		storage.index(
+			network,
+			channel,
+			new Msg({
+				type: "message" as any,
+				from: new User({nick: "kofany"}),
+				text,
+				time: new Date(at),
+			})
+		);
+
+	const texts = async (storage: EncryptedMessageStorage) => {
+		await storage.flush(); // getLastMessages reads the database only
+		return (await storage.getLastMessages(network.uuid, channel.name, 100)).map((m) => m.text);
+	};
+
+	beforeEach(function () {
+		dir = fs.mkdtempSync(path.join(os.tmpdir(), "encrypted-storage-"));
+		file = path.join(dir, "test.encrypted.sqlite3");
+		stubs = [sinon.stub(log, "info"), sinon.stub(log, "error")];
+	});
+
+	afterEach(function () {
+		stubs.forEach((s) => s.restore());
+		fs.rmSync(dir, {recursive: true, force: true});
+	});
+
+	it("re-encrypts the stored history and the batch queue with the new key", async function () {
+		const oldKey = key();
+		const newKey = key();
+		const storage = await open(oldKey);
+		await say(storage, "raz", 1000);
+		await storage.flush();
+		await say(storage, "dwa", 2000); // still in the batch queue
+
+		const result = await storage.reEncrypt(oldKey, newKey);
+		expect(result).to.deep.equal({reEncrypted: 2, skipped: 0});
+		await say(storage, "trzy", 3000); // written with the new key
+		expect(await texts(storage)).to.deep.equal(["raz", "dwa", "trzy"]);
+		await storage.close();
+
+		const reopened = await open(newKey);
+		expect(await texts(reopened)).to.deep.equal(["raz", "dwa", "trzy"]);
+		await reopened.close();
+
+		const withOldKey = await open(oldKey);
+		expect(await texts(withOldKey)).to.deep.equal([
+			"[Decryption failed]",
+			"[Decryption failed]",
+			"[Decryption failed]",
+		]);
+		await withOldKey.close();
+	});
+
+	it("leaves rows the old key cannot read as they were", async function () {
+		const strayKey = key();
+		const stray = await open(strayKey);
+		await say(stray, "z innym kluczem", 500);
+		await stray.close();
+
+		const oldKey = key();
+		const newKey = key();
+		const storage = await open(oldKey);
+		await say(storage, "raz", 1000);
+		const result = await storage.reEncrypt(oldKey, newKey);
+		expect(result).to.deep.equal({reEncrypted: 1, skipped: 1});
+		await storage.close();
+
+		const withStrayKey = await open(strayKey);
+		expect((await texts(withStrayKey))[0]).to.equal("z innym kluczem");
+		await withStrayKey.close();
+	});
+
+	it("changes nothing when re-encrypting fails", async function () {
+		const oldKey = key();
+		const storage = await open(oldKey);
+		await say(storage, "raz", 1000);
+		await storage.flush();
+		await say(storage, "dwa", 2000); // queued
+
+		const db = storage.database;
+		const prepare = db.prepare.bind(db);
+		const failing = sinon.stub(db, "prepare").callsFake((sql: string) => {
+			if (sql.startsWith("UPDATE messages")) {
+				throw new Error("disk I/O error");
+			}
+
+			return prepare(sql);
+		});
+
+		try {
+			await storage.reEncrypt(oldKey, key()).then(
+				() => expect.fail("should have failed"),
+				(error: Error) => expect(error.message).to.equal("disk I/O error")
+			);
+		} finally {
+			failing.restore();
+		}
+
+		// old key still in use, the queued message kept
+		expect(await texts(storage)).to.deep.equal(["raz", "dwa"]);
+		await storage.close();
+		const reopened = await open(oldKey);
+		expect(await texts(reopened)).to.deep.equal(["raz", "dwa"]);
+		await reopened.close();
+	});
+
+	it("keeps its own copy of the key", async function () {
+		const clientKey = key();
+		const storage = await open(clientKey);
+		clientKey.fill(0); // the client zeroes its key on quit
+		await say(storage, "raz", 1000);
+		expect(await texts(storage)).to.deep.equal(["raz"]);
+		await storage.close();
+	});
+
+	describe("IrssiClient.switchEncryptionKey", function () {
+		const switchKey = (self: unknown, newKey: Buffer) =>
+			IrssiClient.prototype.switchEncryptionKey.call(self, newKey);
+
+		it("re-encrypts with the old and the new key, then zeroes the old one", async function () {
+			const oldKey = key();
+			const newKey = key();
+			const reEncrypt = sinon.stub().resolves({reEncrypted: 1, skipped: 0});
+			const client = {encryptionKey: oldKey, messageStorage: {reEncrypt}};
+
+			await switchKey(client, newKey);
+			expect(reEncrypt.calledOnce).to.equal(true);
+			expect(reEncrypt.args[0][0]).to.equal(oldKey);
+			expect(reEncrypt.args[0][1]).to.equal(newKey);
+			expect(client.encryptionKey).to.equal(newKey);
+			expect(oldKey.every((b) => b === 0)).to.equal(true);
+		});
+
+		it("does nothing for the same key", async function () {
+			const oldKey = key();
+			const reEncrypt = sinon.stub().resolves();
+			const client = {encryptionKey: oldKey, messageStorage: {reEncrypt}};
+
+			await switchKey(client, Buffer.from(oldKey));
+			expect(reEncrypt.called).to.equal(false);
+			expect(client.encryptionKey).to.equal(oldKey);
+			expect(oldKey.some((b) => b !== 0)).to.equal(true);
+		});
+
+		it("keeps the old key when re-encrypting fails", async function () {
+			const oldKey = key();
+			const reEncrypt = sinon.stub().rejects(new Error("busy"));
+			const client = {encryptionKey: oldKey, messageStorage: {reEncrypt}};
+
+			await switchKey(client, key()).then(
+				() => expect.fail("should have failed"),
+				(error: Error) => expect(error.message).to.equal("busy")
+			);
+			expect(client.encryptionKey).to.equal(oldKey);
+			expect(oldKey.some((b) => b !== 0)).to.equal(true);
+		});
+
+		it("only sets the key without a message storage", async function () {
+			const newKey = key();
+			const client = {encryptionKey: key(), messageStorage: null};
+			await switchKey(client, newKey);
+			expect(client.encryptionKey).to.equal(newKey);
+		});
+	});
+});
