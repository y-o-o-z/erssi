From 4a8cb2476586c6b8d03fcf6cb1519fe364e516eb Mon Sep 17 00:00:00 2001
From: yooz <136268860+y-o-o-z@users.noreply.github.com>
Date: Fri, 2 Oct 2026 17:54:18 +0200
Subject: [PATCH 6/6] local: close the fe-web connection with a close handshake
 on shutdown

terminate() dropped the TCP connection without a TLS close_notify, and erssi
printed 'unexpected eof while reading' plus 'Connection error' in Notices on
every Nexus restart. close() first, terminate() only after the 1 s timeout.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 server/feWebClient/feWebSocket.ts | 38 +++++++++++++++----------------
 1 file changed, 18 insertions(+), 20 deletions(-)

diff --git a/server/feWebClient/feWebSocket.ts b/server/feWebClient/feWebSocket.ts
index 58c553dd..133935e7 100644
--- a/server/feWebClient/feWebSocket.ts
+++ b/server/feWebClient/feWebSocket.ts
@@ -355,34 +355,32 @@ export class FeWebSocket extends EventEmitter {
 			this.ws.removeAllListeners("error");
 			this.ws.removeAllListeners("close");
 
-			// Wait for close event before resolving
-			const onClose = () => {
-				this._isConnected = false;
-				this.isAuthenticated = false;
-				logger.debug("[FeWebSocket] Disconnect complete");
-				resolve();
-			};
-
-			this.ws.once("close", onClose);
+			// Close handshake (WebSocket close frame, then TLS close_notify), so
+			// erssi sees an orderly disconnect; terminate() only when it does
+			// not complete in time.
+			const ws = this.ws;
+			this.ws = null;
 
 			// Timeout safety - resolve after 1s even if close doesn't come
 			const timeoutId = setTimeout(() => {
-				this.ws?.removeListener("close", onClose);
-
-				// Also clean up all listeners in case timeout fires first
-				if (this.ws) {
-					this.ws.removeAllListeners();
-				}
-
+				ws.removeAllListeners();
+				ws.terminate();
 				this._isConnected = false;
 				this.isAuthenticated = false;
-				logger.warn("[FeWebSocket] Disconnect timeout - forcing resolve");
+				logger.warn("[FeWebSocket] Disconnect timeout - connection terminated");
 				resolve();
 			}, 1000);
 
-			// Terminate (should trigger close event)
-			this.ws.terminate();
-			this.ws = null;
+			// a socket error while closing must not become an unhandled event
+			ws.on("error", () => undefined);
+			ws.once("close", () => {
+				clearTimeout(timeoutId);
+				this._isConnected = false;
+				this.isAuthenticated = false;
+				logger.debug("[FeWebSocket] Disconnect complete");
+				resolve();
+			});
+			ws.close(1001, "client shutdown");
 		});
 	}
 
