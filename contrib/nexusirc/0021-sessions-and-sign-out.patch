 		logger.info(
 			`User ${chalk.bold(this.name)}: browser detached (${socketId}), remaining: ${
 				this.attachedBrowsers.size
@@ -1800,6 +1812,77 @@ export class IrssiClient {
 		this.save();
 	}
 
+	/**
+	 * Sessions of this user for the settings page; "current" is the session
+	 * of the asking browser, "active" counts browsers attached with it.
+	 */
+	sessionList(socketId: string) {
+		const mine = this.browserTokens.get(socketId);
+		const tokens = [...this.browserTokens.values()];
+		return Object.entries(this.config.sessions).map(([hash, session]: [string, any]) => ({
+			current: hash === mine,
+			active: tokens.filter((t) => t === hash).length,
+			lastUse: session.lastUse || 0,
+			ip: session.ip || "",
+			agent: session.agent || "",
+			token: hash,
+		}));
+	}
+
+	sendSessionList(socket: Socket): void {
+		socket.emit("sessions:list", this.sessionList(socket.id));
+	}
+
+	/**
+	 * Sign a session out: its token stops working and every browser using it
+	 * is sent back to the sign-in page. Without a token: the asking browser.
+	 */
+	signOut(socket: Socket, tokenHash?: string): void {
+		const target = tokenHash || this.browserTokens.get(socket.id);
+
+		if (!target || !Object.prototype.hasOwnProperty.call(this.config.sessions, target)) {
+			return;
+		}
+
+		this.revokeSessions([target]);
+	}
+
+	/** Sign out every session except the asking browser's own. */
+	signOutOthers(socket: Socket): void {
+		const mine = this.browserTokens.get(socket.id);
+		this.revokeSessions(Object.keys(this.config.sessions).filter((hash) => hash !== mine));
+	}
+
+	private revokeSessions(hashes: string[]): void {
+		if (hashes.length === 0) {
+			return;
+		}
+
+		for (const hash of hashes) {
+			delete this.config.sessions[hash];
+		}
+
+		this.save();
+
+		for (const [socketId, hash] of [...this.browserTokens]) {
+			if (!hashes.includes(hash)) {
+				continue;
+			}
+
+			const browser = this.attachedBrowsers.get(socketId);
+			browser?.socket.emit("sign-out");
+			browser?.socket.disconnect(true);
+		}
+
+		for (const [socketId, browser] of this.attachedBrowsers) {
+			if (!hashes.includes(this.browserTokens.get(socketId) || "")) {
+				this.sendSessionList(browser.socket);
+			}
+		}
+
+		logger.info(`User ${chalk.bold(this.name)}: signed out ${hashes.length} session(s)`);
+	}
+
 	/**
 	 * Save user config to disk
 	 */
