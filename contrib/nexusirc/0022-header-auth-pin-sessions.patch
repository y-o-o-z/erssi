diff --git a/server/feWebClient/feWebPin.ts b/server/feWebClient/feWebPin.ts
new file mode 100644
index 0000000..4d4cd14
--- /dev/null
+++ b/server/feWebClient/feWebPin.ts
@@ -0,0 +1,81 @@
+/**
+ * Certificate pin of the fe-web connection to erssi.
+ *
+ * erssi keeps its fe-web certificate in ~/.erssi/fe-web-cert.pem. With it,
+ * only that erssi is trusted - not whatever else listens on the port while
+ * erssi restarts (it would get the password).
+ */
+import fs from "fs";
+import os from "os";
+import path from "path";
+import {log} from "../logger.js";
+
+export type FeWebTls = {
+	rejectUnauthorized: boolean;
+	ca?: Buffer;
+};
+
+/** The pinned certificate cannot be used: do not connect at all. */
+export class FeWebPinError extends Error {}
+
+/** erssi on this machine (only then is its ~/.erssi ours to read). */
+export function isLocalHost(host: string): boolean {
+	const name = String(host || "")
+		.trim()
+		.toLowerCase()
+		.replace(/^\[(.*)\]$/, "$1");
+	return name === "localhost" || name === "127.0.0.1" || name === "::1";
+}
+
+export function defaultCertFile(): string {
+	return path.join(os.homedir(), ".erssi", "fe-web-cert.pem");
+}
+
+/**
+ * TLS options for one connection attempt. Called on every (re)connect, so a
+ * certificate erssi writes (or regenerates) later is picked up.
+ *  - caFile set by the user: it must be readable, otherwise no connection
+ *    (falling back to "any certificate" would silently drop the pin);
+ *  - else erssi's own certificate, but only for an erssi on this machine -
+ *    a remote erssi's certificate is not in our home directory;
+ *  - no certificate (a local erssi's first run, or a remote erssi without
+ *    caFile): the "verify" setting of the user, with a warning when off.
+ */
+export function feWebTls(
+	conn: {host: string; port: number; caFile?: string; rejectUnauthorized?: boolean},
+	who: string
+): FeWebTls {
+	const where = `${conn.host}:${conn.port}`;
+
+	if (conn.caFile) {
+		try {
+			return {rejectUnauthorized: true, ca: fs.readFileSync(conn.caFile)};
+		} catch (error) {
+			throw new FeWebPinError(
+				`${who}: cannot read the fe-web certificate ${conn.caFile} (${
+					(error as NodeJS.ErrnoException).code || String(error)
+				}) - not connecting to ${where}`
+			);
+		}
+	}
+
+	if (isLocalHost(conn.host)) {
+		const file = defaultCertFile();
+
+		try {
+			return {rejectUnauthorized: true, ca: fs.readFileSync(file)};
+		} catch {
+			// first run: erssi has not written it yet
+		}
+
+		if (!conn.rejectUnauthorized) {
+			log.warn(
+				`${who}: no fe-web certificate in ${file} - accepting any certificate from ${where}`
+			);
+		}
+	} else if (!conn.rejectUnauthorized) {
+		log.warn(`${who}: no caFile for the erssi at ${where} - accepting any certificate`);
+	}
+
+	return {rejectUnauthorized: Boolean(conn.rejectUnauthorized)};
+}
