diff --git a/client/js/auth.ts b/client/js/auth.ts
index 5a764f8..d251836 100644
--- a/client/js/auth.ts
+++ b/client/js/auth.ts
@@ -1,9 +1,30 @@
 import storage from "./localStorage";
 import location from "./location";
+import socket from "./socket";
 
 export default class Auth {
 	static signout() {
 		storage.clear();
 		location.reload();
 	}
+
+	/**
+	 * Sign this browser out: the server revokes its session first, then the
+	 * stored token goes. Leaving at once could drop the request with the
+	 * page, and the token would keep working. No answer in 3 s (server
+	 * unreachable): leave anyway.
+	 */
+	static signoutSession() {
+		let done = false;
+
+		const leave = () => {
+			if (!done) {
+				done = true;
+				Auth.signout();
+			}
+		};
+
+		socket.emit("sign-out", null, leave);
+		setTimeout(leave, 3000);
+	}
 }
