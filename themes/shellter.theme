    cant_show_sticky_windows = "%ZFF7B72⚠%N You can't show sticky windows (use /WINDOW STICK OFF)";
    window_not_sticky = "%Z3FB950✓%N Window is not sticky";
    window_set_sticky = "%Z3FB950✓%N Window set sticky";
    window_unset_sticky = "%Z3FB950✓%N Window is not sticky anymore";
    window_info_sticky = "%#Sticky  : $0";
    window_info_scroll = "%#Scroll  : $0";
    window_scroll = "%Z3FB950✓%N Window scroll mode is now $0";
    window_scroll_unknown = "%ZFF7B72⚠%N Unknown scroll mode $0, must be ON, OFF or DEFAULT";

    # Statusbar management
    statusbar_list_header = "%#Name                           Type   Placement Position Visible";
    statusbar_list_footer = "";
    statusbar_list = "%#$[30]0 $[6]1 $[9]2 $[8]3 $4";
    statusbar_info_name = "%#Statusbar: {hilight $0}";
    statusbar_info_type = "%#Type     : $0";
    statusbar_info_placement = "%#Placement: $0";
    statusbar_info_position = "%#Position : $0";
    statusbar_info_visible = "%#Visible  : $0";
    statusbar_info_item_header = "%#Items    : Name                                Priority  Alignment";
    statusbar_info_item_footer = "";
    statusbar_info_item_name = "%#         : $[35]0 $[9]1 $2";
    statusbar_not_found = "%ZFF7B72⚠%N Statusbar doesn't exist: $0";
    statusbar_item_not_found = "%ZFF7B72⚠%N Statusbar item doesn't exist: $0";
    statusbar_unknown_command = "%ZFF7B72⚠%N Unknown statusbar command: $0";
    statusbar_unknown_type = "%ZFF7B72⚠%N Statusbar type must be 'window' or 'root'";
    statusbar_unknown_placement = "%ZFF7B72⚠%N Statusbar placement must be 'top' or 'bottom'";
    statusbar_unknown_visibility = "%ZFF7B72⚠%N Statusbar visibility must be 'always', 'active' or 'inactive'";

    # Paste warning
    paste_warning = "%ZFCD34D⚠%N Pasting $0 lines to $1. Press Ctrl-K if you wish to do this or Ctrl-C to cancel.";
    paste_prompt = "%ZFCD34D⚠%N Hit Ctrl-K to paste, Ctrl-C to abort?";

    # === ENHANCED SIDEPANEL THEME ===
    # Format: $0 = window number, $1 = window name
    sidepanel_header = "%Z484F58$[-2]0%N %ZF59E0B%_$1%_%N";
    sidepanel_item = "%Z484F58$[-2]0%N %Z7D8590$1%N";
    sidepanel_item_selected = "%ZF59E0B$[-2]0%N %ZFCD34D%_$1%_%N";

    # === ACTIVITY HIERARCHY (by priority) ===
    sidepanel_item_nick_mention = "%ZFF7B72$[-2]0%N %ZFF7B72%_$1%_%N";
    sidepanel_item_query_msg = "%ZD2A8FF$[-2]0%N %ZD2A8FF%_$1%_%N";
    sidepanel_item_activity = "%Z484F58$[-2]0%N %ZE6EDF3$1%N";
    sidepanel_item_events = "%Z484F58$[-2]0%N %Z79C0FF$1%N";
    sidepanel_item_highlight = "%ZFF7B72$[-2]0%N %ZFF7B72$1%N";

    # Lista nickow: symbol statusu ($0) i nick ($1) w kolorze rangi - te same
    # barwy co znak trybu w wiadomosciach (nick_mode_color_*): opy bursztyn,
    # voice niebieski, halfop zielony, wlasciciel czerwony, reszta szara
    sidepanel_nick_owner_status = " %ZFF7B72%_$0%_%N%ZFFA198$1%N";
    sidepanel_nick_admin_status = " %ZFF7B72%_$0%_%N%ZFFA198$1%N";
    sidepanel_nick_op_status = " %ZF59E0B%_$0%_%N%ZFCD34D$1%N";
    sidepanel_nick_halfop_status = " %Z3FB950%_$0%_%N%Z7EE787$1%N";
    sidepanel_nick_voice_status = " %Z79C0FF%_$0%_%N%ZA5D6FF$1%N";
    sidepanel_nick_normal_status = " %Z484F58$0%N%Z7D8590$1%N";
  };

  "fe-common/perl" = {
    script_not_found = "%ZFF7B72✗%N Script {hilight $0} not found";
    script_not_loaded = "%ZFF7B72✗%N Script {hilight $0} is not loaded";
    script_loaded = "%Z3FB950⚙%N Loaded script {hilight $0}";
    script_unloaded = "%Z6E7681⚙%N Unloaded script {hilight $0}";
    no_scripts_loaded = "%Z7D8590⚙%N No scripts are loaded";
    script_list_header = "%#%ZF59E0B⚙%N Loaded scripts:";
    script_list_line = "%#  %Z79C0FF◆%N $[!15]0 %Z6E7681⟫%N $1";
    script_list_footer = "";
    script_error = "%ZFF7B72⚠%N {error Error in script {hilight $0}:}";
  };
};

