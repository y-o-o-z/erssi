# shellter v1.2 — motyw erssi w barwach shellter.me ("Your shell, your shelter")
#
# Paleta z arkusza stylow shellter.me (ciemny wariant, GitHub Primer):
#   tlo #0b0d10 · karta #0e1116 · muted #161b22 · ramka #30363d
#   tekst #e6edf3 · tekst przygaszony #7d8590 · subtelny #6e7681 / #484f58
#   akcent bursztyn #f59e0b · jasny bursztyn #fcd34d · czerwien #ff7b72
#   uzupelnienia Primer: zielen #3fb950 · niebieski #79c0ff · fiolet #d2a8ff
#
# Kolory 24-bit (%Z/%z); erssi z forka y-o-o-z/erssi >= 1.3.2 zamienia je na
# najblizsze z palety 256 tam, gdzie terminal nie ma 24 bitow. Ustawienia
# (w forku domyslne):
#   /set sidepanel_left_width 22        (pelne nazwy kanalow, np. #bash.org.pl)
#   /set nick_column_width 13           (1 znak trybu + 12 znakow nicka)
#   /set nick_hash_colors #f59e0b #fcd34d #fdba74 #79c0ff #a5d6ff #d2a8ff #3fb950 #7ee787
#   /set nick_mode_color_op %ZF59E0B%_       (@ bursztyn)
#   /set nick_mode_color_voice %Z79C0FF%_    (+ niebieski)
#   /set nick_mode_color_halfop %Z3FB950%_   (% zielony)
#   /set nick_mode_color_owner %ZFF7B72%_    (~ & czerwony)
#   /set hilight_color %ZFCD34D              (podswietlenia w barwach motywu,
#        np. /hilight -color %ZFF7B72%_ <nick>)
#
# Uklad: KAZDA linia ma czas, kolumne 13 znakow i separator "│", tekst
# zaczyna sie zawsze w tym samym miejscu, zawiniete linie pod tekstem:
#   wiadomosci       nick z trybem (@ + %) w kolorze rangi
#   zdarzenia        znak: → wejscie, ← wyjscie, ⊘ kick/ban, ± tryb, ¶ temat,
#                    ⇄ nick, * /me, · informacja, ⚙ serwer, ◆ CTCP, ! wallop
#   komunikaty erssi "erssi" (line_start_irssi)
#   WHOIS            nick, potem etykiety pol: chans, node, idle, info, ...
#   notice / priv    nick nadawcy; wlasne: twoj nick i "→ odbiorca ⟫"
# Kolumna = nick_column_width 13: zdarzenie to 12 spacji + 1 znak, nicki
# dopelnia $[-13] wpisane wprost w format (w abstrakcie irssi dopelnia
# niedokladnie). Inna szerokosc kolumny -> popraw spacje i $[-13].
# Komendy wypisujace listy (/set, /help, /script list) zostaja bez kolumny.
#
# Wejscie na kanal (zloty srodek irssi / WeeChat / repartee): temat, kto i kiedy
# go ustawil, data utworzenia i jedna linia "N nicks · ops · voiced · regular" -
# tabela nickow tylko przez /names (lista jest w panelu; erssi:
# show_names_on_join_limit 1). Bez "synced in" (channel_synced = "").

default_color = "-1";
info_eol = "false";

replaces = { "[]=" = "%w$*%N"; };

abstracts = {

  ##
  ## generic
  ##

  line_start = "%N";

  timestamp = "%Z6E7681$*%N";

  hilight = "%ZFCD34D%_$*%_%N";

  error = "%ZFF7B72$*%N";

  channel = "%ZF59E0B%_$*%_%N";

  nick = "%_$*%_%N";

  nickhost = "%Z6E7681⟨%N$*%Z6E7681⟩%N";

  server = "%Z3FB950%_$*%_%N";

  comment = "%Z6E7681⟨%N$*%Z6E7681⟩%N";

  reason = "%Z7D8590⟨%N$*%Z7D8590⟩%N";

  mode = "%ZD2A8FF%_$*%_%N";

  ##
  ## kolumna: 13 znakow (zdarzenie = 12 spacji + znak) i separator "│";
  ## %| po spacji: zawiniete linie zaczynaja sie rowno z tekstem
  ##

  col = "%Z484F58 │%N %|";

  ev_join = "            %Z3FB950→{col}";
  ev_part = "            %ZFCD34D←{col}";
  ev_quit = "            %ZFF7B72←{col}";
  ev_kick = "            %ZFF7B72⊘{col}";
  ev_nick = "            %ZD2A8FF⇄{col}";
  ev_mode = "            %ZD2A8FF±{col}";
  ev_topic = "            %Z79C0FF¶{col}";
  ev_info = "            %Z6E7681·{col}";
  ev_action = "            %ZD2A8FF*{col}";
  ev_server = "            %Z3FB950⚙{col}";
  ev_ctcp = "            %Z79C0FF◆{col}";
  ev_wallop = "            %ZFCD34D!{col}";
  ev_erssi = "        %ZF59E0Berssi{col}";

  ##
  ## channel specific messages
  ##

  channick_hilight = "%Z3FB950%_$*%_%N";
  chanhost_hilight = "{nickhost %Z7D8590$*%N}";

  channick = "%Z7D8590$*%N";
  chanhost = "{nickhost %Z6E7681$*%N}";

  channick_hilight2 = "%ZFCD34D$*%N";

  channelhilight = "%ZF59E0B$*%N";

  ban = "%Z79C0FF$*%N";

  ##
  ## messages
  ##

  msgnick = "$0$1-{col}";

  ownmsgnick = "{msgnick $nickmode%ZFCD34D%_$nicktrunc%_%N}";
  ownnick = "%ZFCD34D%_$*%_%N";

  pubmsgnick = "{msgnick $nickmode$nickcolored}";
  pubnick = "%ZE6EDF3$*%N";

  pubmsgmenick = "{msgnick $nickmode%ZFF7B72%_$nicktrunc%_}%ZFCD34D";
  menick = "%ZFF7B72%_$*%_%N";

  pubmsghinick = "{msgnick $nickmode%ZFCD34D%_$nicktrunc%_}%ZFCD34D";

  msgchannel = "%Z6E7681:%Z79C0FF$*%N";



  ownprivnick = "%ZFCD34D%_$[-13]0%_%N";


  ##
  ## actions (/ME)
  ##

  action_core = "{ev_action}%ZD2A8FF%_$*%_%N";

  action = "{action_core $*} ";

  ownaction = "{action $*}";

  ownaction_target = "{action_core $0}%Z6E7681:%Z79C0FF$1%N ";

  pvtaction = "{ev_action}%ZD2A8FF%_$0%_%Z6E7681 ⟨query⟩%N ";
  pvtaction_query = "{action $*}";

  pubaction = "{action $*}";

  ##
  ## other IRC events
  ##

  whois = "%ZF59E0B◆%N $[8]0 %Z79C0FF⟫%N $1-";

  pubnotice_channel = "%Z6E7681:%Z79C0FF$*";
  servernotice = "{ev_server}%Z3FB950$*%Z6E7681 ⟫%N ";

  ctcp = "%Z79C0FF$*%N";

  wallop = "{ev_wallop}";
  wallop_nick = "%ZFCD34D$*%Z6E7681 ⟫%N";
  wallop_action = "%ZD2A8FF★ $*%N ";

  netsplit = "%ZFF7B72⚠ $*%N";
  netjoin = "%Z3FB950→ $*%N";

  names_prefix = "{ev_info}";
  names_nick = "%Z6E7681$0%Z7D8590$1%N ";
  names_nick_op = "%ZF59E0B@%ZFCD34D%_$1%_%N ";
  names_nick_halfop = "%Z3FB950%%%Z79C0FF$1%N ";
  names_nick_voice = "%Z79C0FF+%Z7D8590$1%N ";
  names_users = "%Z6E7681⟨%Z79C0FF$0 %Z6E7681nicks%Z6E7681⟩%N";
  names_channel = "%ZF59E0B$*%N";

  dcc = "%Z79C0FF$*%N";
  dccfile = "%_$*%_%N";

  dccownquerynick = "%_$*%N";
  dccownaction = "{action $*}";
  dccownaction_target = "{action_core $0}%Z6E7681:%Z79C0FF$1%N ";

  dccquerynick = "%ZF59E0B$*%N";
  dccaction = "{ev_action}%ZD2A8FF%_$*%_%N ";

  ##
  ## statusbar
  ##

  sb_background = "%z161B22";
  window_border = "%ZF59E0B│%N";
  sb_topic_bg = "%z0E1116%ZE6EDF3";
  sb = " %ZE6EDF3$*%N %Z484F58│%N";
  sbmode = "%Z6E7681(%ZF59E0B+%Z7D8590$*%Z6E7681)%N";
  sbservertag = ":$0 (change with ^X)";
  sbmore = " %Z484F58── %Z7D8590wiecej %Z484F58── ";
  sblag = "%ZFF7B72lag%N %Z7D8590$0-%N s";
  sb_default_bg = "%z161B22";
  sb_act_sep = "%Z484F58,%N";
  sb_act_text = "%Z7D8590$*";
  sb_act_msg = "%ZE6EDF3$*";
  sb_act_hilight = "%ZFF7B72%_$*%_";
  sb_act_hilight_color = "%ZFCD34D%_$0$1-%_%N";
  sb_info1_bg = "%z161B22";
  sb_window_bg = "%z161B22%ZE6EDF3";
  sb_window2_bg = "%z161B22%ZE6EDF3";
  sb_info2_bg = "%z161B22";

  sbstart = "";
  sbend = " ";
  topicsbstart = "{sbstart $*}";
  topicsbend = "{sbend $*}";

  prompt = "%ZF59E0B$$%N %Z7D8590$*%N %Z484F58❯%N ";

  sbaway = " %ZFCD34Daway%N";
  sbnickmode = "$0";
};

##############################################################################
# EVENT FORMATS
##############################################################################

formats = {
  "fe-common/core" = {
    join_extended = "{ev_join}{channick_hilight $0} {chanhost_hilight $1} %Z6E7681joined%N {channel $2} {comment $4}";
    join_extended_account = "{ev_join}{channick_hilight $0} {chanhost_hilight $1} %Z6E7681joined%N {channel $2} %Z6E7681as%N {hilight $3} {comment $4}";
    host_changed = "{ev_nick}{channick $0} {chanhost $1} %Z6E7681changed host%N";
    logged_in = "{ev_info}{channick_hilight $0} {chanhost $1} %Z6E7681logged in as%N {hilight $2}";
    logged_out = "{ev_info}{channick $0} {chanhost $1} %Z6E7681logged out%N";
    invite_other = "{ev_info}{nick $0} %Z6E7681was invited to%N {channel $2} %Z6E7681by%N {channick_hilight $1}";
    notify_away_channel = "            %ZFCD34D◇{col}{channick $0} {chanhost $1} %Z6E7681is away:%N {reason $2}";
    notify_unaway_channel = "            %Z3FB950◆{col}{channick_hilight $0} {chanhost $1} %Z6E7681is back%N";
    line_start = "{line_start}";
    line_start_irssi = "{line_start}{ev_erssi}";
    timestamp = " {timestamp $Z} ";
    servertag = "%ZF59E0B$[-7]0%Z484F58 ›%N ";
    daychange = "            %Z79C0FF◷{col}%Z79C0FF%%A, %%d %%B %%Y%N";
    talking_with = "%Z3FB950⟫%N You are now talking with {nick $0}";
    refnum_too_low = "Window number must be greater than 1";
    error_server_sticky = "Window's server is sticky and it cannot be changed without -unsticky option";
    set_server_sticky = "Window's server set sticky";
    unset_server_sticky = "Window's server isn't sticky anymore";
    window_name_not_unique = "Window names must be unique";
    window_level = "Window level is now $0";
    window_set_immortal = "Window is now immortal";
    window_unset_immortal = "Window isn't immortal anymore";
    window_immortal_error = "Window is immortal, if you really want to close it, say /WINDOW IMMORTAL OFF";
    windowlist_header = "%#%ZF59E0BRef%N %Z79C0FFName                 Active item     Server          Level%N";
    windowlist_line = "%#%ZF59E0B$[3]0%N %|%W$[20]1%N %Z79C0FF$[15]2%N %Z3FB950$[15]3%N %Z6E7681$4%N";
    windowlist_footer = "";
    windows_layout_saved = "Layout of windows is now remembered";
    windows_layout_reset = "Layout of windows reset to defaults";

    looking_up = "%ZF59E0B⚙%N Looking up {server $0}";
    connecting = "%Z3FB950→%N Connecting to {server $0} %Z6E7681⟨%N$1%Z6E7681⟩%N port {hilight $2}";
    reconnecting = "%ZFCD34D↻%N Reconnecting to {server $0} %Z6E7681⟨%N$1%Z6E7681⟩%N port {hilight $2} - use /RMRECONNS to abort";
    connection_established = "%Z3FB950✓%N Connection to {server $0} established";
    cant_connect = "%ZFF7B72✗%N Unable to connect server {server $0} port {hilight $1} {reason $2}";
    connection_lost = "%ZFF7B72✗%N Connection lost to {server $0}";
    lag_disconnected = "%ZFF7B72✗%N No PONG reply from server {server $0} in $1 seconds, disconnecting";
    disconnected = "%ZFF7B72✗%N Disconnected from {server $0} {reason $1}";
    server_quit = "%ZFCD34D×%N Disconnecting from server {server $0}: {reason $1}";
    server_changed = "%Z3FB950⟫%N Changed to {hilight $2} server {server $1}";
    unknown_server_tag = "%ZFF7B72✗%N Unknown server tag {server $0}";
    no_connected_servers = "%ZFF7B72✗%N Not connected to any servers";
    server_list = "{server $0}: $1:$2 ($3)";
    server_lookup_list = "{server $0}: $1:$2 ($3) (connecting...)";
    server_reconnect_list = "{server $0}: $1:$2 ($3) ($5 left before reconnecting)";
    server_reconnect_removed = "%Z3FB950✓%N Removed reconnection to server {server $0} port {hilight $1}";
    server_reconnect_not_found = "%ZFF7B72✗%N Reconnection tag {server $0} not found";
    setupserver_added = "%Z3FB950✓%N Server {server $0} saved";
    setupserver_removed = "%Z3FB950✓%N Server {server $0} removed";
    setupserver_not_found = "%ZFF7B72✗%N Server {server $0} not found";
    your_nick = "%Z3FB950⟫%N Your nickname is {nick $0}";

    join = "{ev_join}{channick_hilight $0} {chanhost_hilight $1} %Z6E7681joined%N {channel $2}";
    part = "{ev_part}{channick $0} {chanhost $1} %Z6E7681left%N {channel $2} {reason $3}";
    kick = "{ev_kick}%ZFF7B72%_$0%_%N %Z6E7681was kicked from%N {channel $1} %Z6E7681by%N {nick $2} {reason $3}";
    quit = "{ev_quit}{channick $0} {chanhost $1} %Z6E7681quit%N {reason $2}";
    quit_once = "{ev_quit}{channel $3} {channick $0} {chanhost $1} {reason $2}";
    invite = "{ev_info}{nick $0} %Z6E7681invites you to%N {channel $1}";
    new_topic = "{ev_topic}{nick $0} %Z6E7681changed the topic of%N {channel $1} %Z6E7681to:%N $2";
    topic_unset = "{ev_topic}{nick $0} %Z6E7681unset the topic of%N {channel $1}";
    your_nick_changed = "{ev_nick}%Z6E7681You are now known as%N {nick $1}";
    nick_changed = "{ev_nick}{channick $0} %Z6E7681is now known as%N {channick_hilight $1}";
    talking_in = "%Z3FB950⟫%N You are now talking in {channel $0}";
    not_in_channels = "%ZFF7B72✗%N You are not on any channels";
    current_channel = "%Z3FB950⟫%N Current channel {channel $0}";
    names = "{ev_info}%Z6E7681Users on%N {channel $0}%Z6E7681:%N $1";
    names_prefix = "%#{names_prefix $0}";
    names_nick_op = "{names_nick_op $0 $1}";
    names_nick_halfop = "{names_nick_halfop $0 $1}";
    names_nick_voice = "{names_nick_voice $0 $1}";
    names_nick = "{names_nick $0 $1}";
    endofnames = "{channel $0}%Z6E7681:%N {hilight $1} %Z6E7681nicks ·%N %ZF59E0B$2%Z6E7681 ops ·%N %Z79C0FF$4%Z6E7681 voiced ·%N %Z7D8590$5%Z6E7681 regular%N";

    chanlist_header = "%#%ZF59E0B⟫%N You are on the following channels:";
    chanlist_line = "%#  {channel $[-10]0} %|%ZD2A8FF+$1%N %Z6E7681(%Z79C0FF$2%Z6E7681):%N $3";
    chansetup_not_found = "%ZFF7B72✗%N Channel {channel $0} not found";
    chansetup_added = "%Z3FB950✓%N Channel {channel $0} saved";
    chansetup_removed = "%Z3FB950✓%N Channel {channel $0} removed";
    chansetup_header = "%#%ZF59E0B⟫%N Channel         Network    Password   Settings";
    chansetup_line = "%#  {channel $[15]0} %|%Z3FB950$[10]1%N %Z7D8590$[10]2%N $3";
    chansetup_footer = "";

    own_msg = "{ownmsgnick $2 {ownnick $0}}$1";
    own_msg_channel = "{ownmsgnick $3 {ownnick $0}{msgchannel $1}}$2";
    own_msg_private = "%ZFCD34D%_$[-13]N%_{col}%ZD2A8FF→ $0%Z6E7681 ⟫%N $1";
    own_msg_private_query = "%ZFCD34D%_$[-13]2%_{col}$1";
    pubmsg_me = "{pubmsgmenick $2 {menick $0}}$1";
    pubmsg_me_channel = "{pubmsgmenick $3 {menick $0}{msgchannel $1}}$2";
    pubmsg_hilight = "{pubmsghinick $0 $3 $1}$2%N";
    pubmsg_hilight_channel = "{pubmsghinick $0 $4 $1{msgchannel $2}}$3%N";
    pubmsg = "{pubmsgnick $2 {pubnick $0}}$1";
    pubmsg_channel = "{pubmsgnick $3 {pubnick $0}{msgchannel $1}}$2";
    msg_private = "%ZD2A8FF%_$[-13]0%_{col}%Z6E7681⟨$1⟩%N $2";
    msg_private_query = "%ZD2A8FF%_$[-13]0%_{col}$2";
    no_msgs_got = "%ZFF7B72✗%N You have not received a message from anyone yet";
    no_msgs_sent = "%ZFF7B72✗%N You have not sent a message to anyone yet";

    query_start = "%Z3FB950⟫%N Starting query with {nick $0} on {server $1}";
    query_stop = "%ZFCD34D⟪%N Closing query with {nick $0}";
    no_query = "%ZFF7B72✗%N No query with {nick $0}";
    query_server_changed = "%Z3FB950⟫%N Query with {nick $0} changed to server {server $1}";

    hilight_header = "%#%ZFCD34D⟫%N Highlights:";
    hilight_line = "%#  %ZFCD34D$[-4]0%N $1 $2 $3$4";
    hilight_footer = "";
    hilight_not_found = "%ZFF7B72✗%N Highlight not found: $0";
    hilight_removed = "%Z3FB950✓%N Highlight removed: $0";

    alias_added = "%Z3FB950✓%N Alias $0 added";
    alias_removed = "%Z3FB950✓%N Alias $0 removed";
    alias_not_found = "%ZFF7B72✗%N No such alias: $0";
    aliaslist_header = "%#%Z79C0FF⟫%N Aliases:";
    aliaslist_line = "%#  %Z79C0FF◆%N $[10]0 %Z6E7681⟫%N $1";
    aliaslist_footer = "";

    log_opened = "%Z3FB950≡%N Log file {hilight $0} opened";
    log_closed = "%Z6E7681≡%N Log file {hilight $0} closed";
    log_create_failed = "%ZFF7B72✗%N Couldn't create log file {hilight $0}: $1";
    log_locked = "%ZFF7B72!%N Log file {hilight $0} is locked, probably by another running erssi";
    log_not_open = "%ZFF7B72✗%N Log file {hilight $0} not open";
    log_started = "%Z3FB950≡%N Started logging to file {hilight $0}";
    log_stopped = "%Z6E7681≡%N Stopped logging to file {hilight $0}";
    log_list_header = "%#Logs:";
    log_list = "%#$0 $1: $2 $3$4$5";
    log_list_footer = "";
    windowlog_file = "%Z3FB950≡%N Window LOGFILE set to $0";
    windowlog_file_logging = "%ZFF7B72✗%N Can't change window's logfile while log is on";

    no_away_msgs = "%Z3FB950◆%N No new messages in awaylog";
    away_msgs = "%ZFCD34D◇%N {hilight $1} new messages in awaylog:";
    away = "            %ZFCD34D◇{col}You have been marked as being away";
    unaway = "            %Z3FB950◆{col}You are no longer marked as being away";

    module_header = "%#%ZF59E0B⚙%N Module               Type    Submodules";
    module_line = "%#  %Z79C0FF◆%N $[!20]0 %ZD2A8FF$[7]1%N $2";
    module_footer = "";
    module_already_loaded = "%ZFCD34D⚠%N Module {hilight $0/$1} already loaded";
    module_not_loaded = "%ZFF7B72✗%N Module {hilight $0/$1} is not loaded";
    module_load_error = "%ZFF7B72✗%N Error loading module {hilight $0/$1}: $2";
    module_invalid = "%ZFF7B72✗%N {hilight $0/$1} isn't erssi module";
    module_loaded = "%Z3FB950⚙%N Loaded module {hilight $0/$1}";
    module_unloaded = "%Z6E7681⚙%N Unloaded module {hilight $0/$1}";

    command_unknown = "%ZFF7B72✗%N Unknown command: $0";
    command_ambiguous = "%ZFCD34D⚠%N Ambiguous command: $0";
    option_unknown = "%ZFF7B72✗%N Unknown option: $0";
    option_ambiguous = "%ZFCD34D⚠%N Ambiguous option: $0";
    option_missing_arg = "%ZFF7B72✗%N Missing required argument for: $0";
    not_enough_params = "%ZFF7B72✗%N Not enough parameters given";
    not_connected = "%ZFF7B72✗%N Not connected to server";
    not_joined = "%ZFF7B72✗%N Not joined to any channel";
    chan_not_found = "%ZFF7B72✗%N Not joined to such channel";
    chan_not_synced = "%ZFCD34D⚠%N Channel not fully synchronized yet, try again after a while";
    illegal_proto = "%ZFF7B72✗%N Command isn't designed for the chat protocol of the active server";
    not_good_idea = "%ZFCD34D⚠%N Doing this is not a good idea. Add -YES option to command if you really mean it";
    invalid_number = "%ZFF7B72✗%N Invalid number";
    invalid_time = "%ZFF7B72✗%N Invalid timestamp";
    invalid_level = "%ZFF7B72✗%N Invalid message level";
    invalid_size = "%ZFF7B72✗%N Invalid size";
    invalid_charset = "%ZFF7B72✗%N Invalid charset: $0";
    eval_max_recurse = "%ZFF7B72✗%N /eval hit maximum recursion limit";
    program_not_found = "%ZFF7B72✗%N Could not find file or file is not executable";

    theme_saved = "%Z3FB950✓%N Theme saved to $0";
    theme_save_failed = "%ZFF7B72✗%N Error saving theme to $0: $1";
    theme_not_found = "%ZFF7B72✗%N Theme {hilight $0} not found";
    theme_changed = "%Z3FB950✓%N Now using theme {hilight $0} ($1)";
    window_theme = "%Z3FB950⟫%N Using theme {hilight $0} in this window";
    window_theme_default = "%Z7D8590⟫%N No theme is set for this window";
    window_theme_changed = "%Z3FB950✓%N Now using theme {hilight $0} ($1) in this window";
