# shellter-light v1.3 — the light variant of the shellter theme, for
# terminals with a light background and daytime work
#
# Same layout, formats and script sections as shellter.theme; only the
# colours differ. Palette (GitHub Primer light, amber accent of shellter.me);
# every text colour has a contrast of at least 4.5:1 on white, decor
# (separators, rules, event glyphs) at least 3:1:
#   background: terminal default (white) · topic bar #f6f8fa · statusbar #eff2f5
#   text #1f2328 · muted #59636e · subtle #687079 · decor #818b98
#   accent amber #9a6700 · deep amber #7d4e00 · red #cf222e
#   green #1a7f37 · blue #0969da · purple #8250df
#
# 24-bit colours (%Z/%z); erssi from the y-o-o-z/erssi fork >= 1.3.2 maps
# them to the nearest colour of the 256 palette where the terminal has no
# 24-bit colour (GNU Screen): text stays dark, the statusbar becomes #eeeeee.
#
# The nick and hilight colours are settings, not part of a theme; the fork's
# defaults are made for the dark theme and too light on white. With this
# theme set:
#   /set theme shellter-light
#   /set nick_hash_colors #9a6700 #7d4e00 #bc4c00 #0969da #0a50ae #8250df #1a7f37 #116329
#   /set nick_mode_color_op %Z9A6700%_       (@ amber)
#   /set nick_mode_color_voice %Z0969DA%_    (+ blue)
#   /set nick_mode_color_halfop %Z1A7F37%_   (% green)
#   /set nick_mode_color_owner %ZCF222E%_    (~ & red)
#   /set hilight_color %Z7D4E00
#   /set hilight_act_color %ZCF222E
#
# Layout: EVERY line has the time, a column of 13 characters and a "│"
# separator, the text always starts at the same place, wrapped lines go
# under the text:
#   messages         nick with its mode (@ + %) in the colour of the rank
#   events           a glyph: → join, ← part/quit, ⊘ kick/ban, ± mode,
#                    ¶ topic, ⇄ nick, * /me, · info, ⚙ server, ◆ CTCP,
#                    ! wallop
#   erssi messages   "erssi" (line_start_irssi)
#   WHOIS            the nick, then field labels: chans, node, idle, info, ...
#   notice / priv    the sender's nick; own: your nick and "→ target ⟫"
# Column = nick_column_width 13: an event is 12 spaces + 1 glyph, nicks are
# padded by $[-13] written into the format itself (irssi pads inexactly in an
# abstract). Another column width -> adjust the spaces and $[-13].
# Commands that print lists (/set, /help, /script list) have no column.
#
# Joining a channel: the topic, who set it and when, the creation date and a
# single "N nicks · ops · voiced · regular" line - the nick table only with
# /names (the list is in the side panel; erssi: show_names_on_join_limit 1).
# No "synced in" (channel_synced = "").

default_color = "-1";
info_eol = "false";

replaces = { "[]=" = "%Z687079$*%N"; };

abstracts = {

  ##
  ## generic
  ##

  line_start = "%N";

  timestamp = "%Z687079$*%N";

  hilight = "%Z7D4E00%_$*%_%N";

  error = "%ZCF222E$*%N";

  channel = "%Z9A6700%_$*%_%N";

  nick = "%_$*%_%N";

  nickhost = "%Z687079⟨%N$*%Z687079⟩%N";

  server = "%Z1A7F37%_$*%_%N";

  comment = "%Z687079⟨%N$*%Z687079⟩%N";

  reason = "%Z59636E⟨%N$*%Z59636E⟩%N";

  mode = "%Z8250DF%_$*%_%N";

  ##
  ## column: 13 characters (an event = 12 spaces + a glyph) and the "│" separator;
  ## %| after the space: wrapped lines start level with the text
  ##

  col = "%Z818B98 │%N %|";

  ev_join = "            %Z1A7F37→{col}";
  ev_part = "            %Z7D4E00←{col}";
  ev_quit = "            %ZCF222E←{col}";
  ev_kick = "            %ZCF222E⊘{col}";
  ev_nick = "            %Z8250DF⇄{col}";
  ev_mode = "            %Z8250DF±{col}";
  ev_topic = "            %Z0969DA¶{col}";
  ev_info = "            %Z687079·{col}";
  ev_action = "            %Z8250DF*{col}";
  ev_server = "            %Z1A7F37⚙{col}";
  ev_ctcp = "            %Z0969DA◆{col}";
  ev_wallop = "            %Z7D4E00!{col}";
  ev_erssi = "        %Z9A6700erssi{col}";

  ##
  ## channel specific messages
  ##

  channick_hilight = "%Z1A7F37%_$*%_%N";
  chanhost_hilight = "{nickhost %Z59636E$*%N}";

  channick = "%Z59636E$*%N";
  chanhost = "{nickhost %Z687079$*%N}";

  channick_hilight2 = "%Z7D4E00$*%N";

  channelhilight = "%Z9A6700$*%N";

  ban = "%Z0969DA$*%N";

  ##
  ## messages
  ##

  msgnick = "$0$1-{col}";

  ownmsgnick = "{msgnick $nickmode%Z7D4E00%_$nicktrunc%_%N}";
  ownnick = "%Z7D4E00%_$*%_%N";

  pubmsgnick = "{msgnick $nickmode$nickcolored}";
  pubnick = "%Z1F2328$*%N";

  pubmsgmenick = "{msgnick $nickmode%ZCF222E%_$nicktrunc%_}%Z7D4E00";
  menick = "%ZCF222E%_$*%_%N";

  pubmsghinick = "{msgnick $nickmode%Z7D4E00%_$nicktrunc%_}%Z7D4E00";

  msgchannel = "%Z687079:%Z0969DA$*%N";



  ownprivnick = "%Z7D4E00%_$[-13]0%_%N";


  ##
  ## actions (/ME)
  ##

  action_core = "{ev_action}%Z8250DF%_$*%_%N";

  action = "{action_core $*} ";

  ownaction = "{action $*}";

  ownaction_target = "{action_core $0}%Z687079:%Z0969DA$1%N ";

  pvtaction = "{ev_action}%Z8250DF%_$0%_%Z687079 ⟨query⟩%N ";
  pvtaction_query = "{action $*}";

  pubaction = "{action $*}";

  ##
  ## other IRC events
  ##

  whois = "%Z9A6700◆%N $[8]0 %Z0969DA⟫%N $1-";

  pubnotice_channel = "%Z687079:%Z0969DA$*";
  servernotice = "{ev_server}%Z1A7F37$*%Z687079 ⟫%N ";

  ctcp = "%Z0969DA$*%N";

  wallop = "{ev_wallop}";
  wallop_nick = "%Z7D4E00$*%Z687079 ⟫%N";
  wallop_action = "%Z8250DF★ $*%N ";

  netsplit = "%ZCF222E⚠ $*%N";
  netjoin = "%Z1A7F37→ $*%N";

  names_prefix = "{ev_info}";
  names_nick = "%Z687079$0%Z59636E$1%N ";
  names_nick_op = "%Z9A6700@%Z7D4E00%_$1%_%N ";
  names_nick_halfop = "%Z1A7F37%%%Z0969DA$1%N ";
  names_nick_voice = "%Z0969DA+%Z59636E$1%N ";
  names_users = "%Z687079⟨%Z0969DA$0 %Z687079nicks%Z687079⟩%N";
  names_channel = "%Z9A6700$*%N";

  dcc = "%Z0969DA$*%N";
  dccfile = "%_$*%_%N";

  dccownquerynick = "%_$*%N";
  dccownaction = "{action $*}";
  dccownaction_target = "{action_core $0}%Z687079:%Z0969DA$1%N ";

  dccquerynick = "%Z9A6700$*%N";
  dccaction = "{ev_action}%Z8250DF%_$*%_%N ";

  ##
  ## statusbar
  ##

  sb_background = "%zEFF2F5";
  window_border = "%Z9A6700│%N";
  sb_topic_bg = "%zF6F8FA%Z1F2328";
  sb = " %Z1F2328$*%n %Z818B98│%n";
  sbmode = "%Z59636E(%Z7D4E00+%Z59636E$*%Z59636E)%n";
  sbservertag = ":$0 (change with ^X)";
  sbmore = " %Z818B98── %Z59636Emore %Z818B98── ";
  sblag = "%ZCF222Elag%n %Z59636E$0-%n s";
  sb_default_bg = "%zEFF2F5";
  sb_act_sep = "%Z818B98,%n";
  sb_act_text = "%Z59636E$*";
  sb_act_msg = "%Z1F2328$*";
  sb_act_hilight = "%ZCF222E%_$*%_";
  sb_act_hilight_color = "%Z7D4E00%_$0$1-%_%n";
  sb_info1_bg = "%zEFF2F5";
  sb_window_bg = "%zEFF2F5%Z1F2328";
  sb_window2_bg = "%zEFF2F5%Z1F2328";
  sb_info2_bg = "%zEFF2F5";

  sbstart = "";
  sbend = " ";
  topicsbstart = "{sbstart $*}";
  topicsbend = "{sbend $*}";

  prompt = "%Z9A6700$$%n %Z59636E$*%n %Z818B98❯%n ";

  sbaway = " %Z7D4E00away%n";
  sbnickmode = "$0";

  # contents of the statusbar items of the default config (see
  # default.theme): clock, nick, window item, modes, lag, activity, "more",
  # prompt ($0 tag, $1- item) and prompt without an item ($1 window name);
  # at least 4.5:1 on the statusbar background #eff2f5
  sb_time = "%Z59636E$*%n";
  sb_nick = "%Z0969DA$*";
  sb_item = "%Z0969DA$*";
  sb_mode = "%Z59636E(%Z0969DA$*%Z59636E)%n";
  sb_lag = "%Z59636Elag%n %Z1F2328$*%n";
  sb_act = "%Z59636Eact%n $*";
  sb_more = "%Z59636E-- %Z1F2328more %Z59636E--";
  sb_prompt = "%Z59636E[%Z0969DA$0%Z59636E❱%n $1-%Z59636E]%n ";
  sb_prompt_empty = "%Z59636E[%Z0969DA$1%Z59636E]%n ";
};

##############################################################################
# EVENT FORMATS
##############################################################################

formats = {
  "fe-common/core" = {
    join_extended = "{ev_join}{channick_hilight $0} {chanhost_hilight $1} %Z687079joined%N {channel $2} {comment $4}";
    join_extended_account = "{ev_join}{channick_hilight $0} {chanhost_hilight $1} %Z687079joined%N {channel $2} %Z687079as%N {hilight $3} {comment $4}";
    host_changed = "{ev_nick}{channick $0} {chanhost $1} %Z687079changed host%N";
    logged_in = "{ev_info}{channick_hilight $0} {chanhost $1} %Z687079logged in as%N {hilight $2}";
    logged_out = "{ev_info}{channick $0} {chanhost $1} %Z687079logged out%N";
    invite_other = "{ev_info}{nick $0} %Z687079was invited to%N {channel $2} %Z687079by%N {channick_hilight $1}";
    notify_away_channel = "            %Z7D4E00◇{col}{channick $0} {chanhost $1} %Z687079is away:%N {reason $2}";
    notify_unaway_channel = "            %Z1A7F37◆{col}{channick_hilight $0} {chanhost $1} %Z687079is back%N";
    line_start = "{line_start}";
    line_start_irssi = "{line_start}{ev_erssi}";
    timestamp = " {timestamp $Z} ";
    servertag = "%Z9A6700$[-7]0%Z818B98 ›%N ";
    daychange = "            %Z0969DA◷{col}%Z0969DA%%A, %%d %%B %%Y%N";
    talking_with = "%Z1A7F37⟫%N You are now talking with {nick $0}";
    refnum_too_low = "Window number must be greater than 1";
    error_server_sticky = "Window's server is sticky and it cannot be changed without -unsticky option";
    set_server_sticky = "Window's server set sticky";
    unset_server_sticky = "Window's server isn't sticky anymore";
    window_name_not_unique = "Window names must be unique";
    window_level = "Window level is now $0";
    window_set_immortal = "Window is now immortal";
    window_unset_immortal = "Window isn't immortal anymore";
    window_immortal_error = "Window is immortal, if you really want to close it, say /WINDOW IMMORTAL OFF";
    windowlist_header = "%#%Z9A6700Ref%N %Z0969DAName                 Active item     Server          Level%N";
    windowlist_line = "%#%Z9A6700$[3]0%N %|%Z1F2328$[20]1%N %Z0969DA$[15]2%N %Z1A7F37$[15]3%N %Z687079$4%N";
    windowlist_footer = "";
    windows_layout_saved = "Layout of windows is now remembered";
    windows_layout_reset = "Layout of windows reset to defaults";

    looking_up = "%Z9A6700⚙%N Looking up {server $0}";
    connecting = "%Z1A7F37→%N Connecting to {server $0} %Z687079⟨%N$1%Z687079⟩%N port {hilight $2}";
    reconnecting = "%Z7D4E00↻%N Reconnecting to {server $0} %Z687079⟨%N$1%Z687079⟩%N port {hilight $2} - use /RMRECONNS to abort";
    connection_established = "%Z1A7F37✓%N Connection to {server $0} established";
    cant_connect = "%ZCF222E✗%N Unable to connect server {server $0} port {hilight $1} {reason $2}";
    connection_lost = "%ZCF222E✗%N Connection lost to {server $0}";
    lag_disconnected = "%ZCF222E✗%N No PONG reply from server {server $0} in $1 seconds, disconnecting";
    disconnected = "%ZCF222E✗%N Disconnected from {server $0} {reason $1}";
    server_quit = "%Z7D4E00×%N Disconnecting from server {server $0}: {reason $1}";
    server_changed = "%Z1A7F37⟫%N Changed to {hilight $2} server {server $1}";
    unknown_server_tag = "%ZCF222E✗%N Unknown server tag {server $0}";
    no_connected_servers = "%ZCF222E✗%N Not connected to any servers";
    server_list = "{server $0}: $1:$2 ($3)";
    server_lookup_list = "{server $0}: $1:$2 ($3) (connecting...)";
    server_reconnect_list = "{server $0}: $1:$2 ($3) ($5 left before reconnecting)";
    server_reconnect_removed = "%Z1A7F37✓%N Removed reconnection to server {server $0} port {hilight $1}";
    server_reconnect_not_found = "%ZCF222E✗%N Reconnection tag {server $0} not found";
    setupserver_added = "%Z1A7F37✓%N Server {server $0} saved";
    setupserver_removed = "%Z1A7F37✓%N Server {server $0} removed";
    setupserver_not_found = "%ZCF222E✗%N Server {server $0} not found";
    your_nick = "%Z1A7F37⟫%N Your nickname is {nick $0}";

    join = "{ev_join}{channick_hilight $0} {chanhost_hilight $1} %Z687079joined%N {channel $2}";
    part = "{ev_part}{channick $0} {chanhost $1} %Z687079left%N {channel $2} {reason $3}";
    kick = "{ev_kick}%ZCF222E%_$0%_%N %Z687079was kicked from%N {channel $1} %Z687079by%N {nick $2} {reason $3}";
    quit = "{ev_quit}{channick $0} {chanhost $1} %Z687079quit%N {reason $2}";
    quit_once = "{ev_quit}{channel $3} {channick $0} {chanhost $1} {reason $2}";
    invite = "{ev_info}{nick $0} %Z687079invites you to%N {channel $1}";
    new_topic = "{ev_topic}{nick $0} %Z687079changed the topic of%N {channel $1} %Z687079to:%N $2";
    topic_unset = "{ev_topic}{nick $0} %Z687079unset the topic of%N {channel $1}";
    your_nick_changed = "{ev_nick}%Z687079You are now known as%N {nick $1}";
    nick_changed = "{ev_nick}{channick $0} %Z687079is now known as%N {channick_hilight $1}";
    talking_in = "%Z1A7F37⟫%N You are now talking in {channel $0}";
    not_in_channels = "%ZCF222E✗%N You are not on any channels";
    current_channel = "%Z1A7F37⟫%N Current channel {channel $0}";
    names = "{ev_info}%Z687079Users on%N {channel $0}%Z687079:%N $1";
    names_prefix = "%#{names_prefix $0}";
    names_nick_op = "{names_nick_op $0 $1}";
    names_nick_halfop = "{names_nick_halfop $0 $1}";
    names_nick_voice = "{names_nick_voice $0 $1}";
    names_nick = "{names_nick $0 $1}";
    endofnames = "{channel $0}%Z687079: nicks%N {hilight $1} %Z687079· ops%N %Z9A6700$2%Z687079 · voiced%N %Z0969DA$4%Z687079 · regular%N %Z59636E$5%N";

    chanlist_header = "%#%Z9A6700⟫%N You are on the following channels:";
    chanlist_line = "%#  {channel $[-10]0} %|%Z8250DF+$1%N %Z687079(%Z0969DA$2%Z687079):%N $3";
    chansetup_not_found = "%ZCF222E✗%N Channel {channel $0} not found";
    chansetup_added = "%Z1A7F37✓%N Channel {channel $0} saved";
    chansetup_removed = "%Z1A7F37✓%N Channel {channel $0} removed";
    chansetup_header = "%#%Z9A6700⟫%N Channel         Network    Password   Settings";
    chansetup_line = "%#  {channel $[15]0} %|%Z1A7F37$[10]1%N %Z59636E$[10]2%N $3";
    chansetup_footer = "";

    own_msg = "{ownmsgnick $2 {ownnick $0}}$1";
    own_msg_channel = "{ownmsgnick $3 {ownnick $0}{msgchannel $1}}$2";
    own_msg_private = "%Z7D4E00%_$[-13]N%_{col}%Z8250DF→ $0%Z687079 ⟫%N $1";
    own_msg_private_query = "%Z7D4E00%_$[-13]2%_{col}$1";
    pubmsg_me = "{pubmsgmenick $2 {menick $0}}$1";
    pubmsg_me_channel = "{pubmsgmenick $3 {menick $0}{msgchannel $1}}$2";
    pubmsg_hilight = "{pubmsghinick $0 $3 $1}$2%N";
    pubmsg_hilight_channel = "{pubmsghinick $0 $4 $1{msgchannel $2}}$3%N";
    pubmsg = "{pubmsgnick $2 {pubnick $0}}$1";
    pubmsg_channel = "{pubmsgnick $3 {pubnick $0}{msgchannel $1}}$2";
    msg_private = "%Z8250DF%_$[-13]0%_{col}%Z687079⟨$1⟩%N $2";
    msg_private_query = "%Z8250DF%_$[-13]0%_{col}$2";
    no_msgs_got = "%ZCF222E✗%N You have not received a message from anyone yet";
    no_msgs_sent = "%ZCF222E✗%N You have not sent a message to anyone yet";

    query_start = "%Z1A7F37⟫%N Starting query with {nick $0} on {server $1}";
    query_stop = "%Z7D4E00⟪%N Closing query with {nick $0}";
    no_query = "%ZCF222E✗%N No query with {nick $0}";
    query_server_changed = "%Z1A7F37⟫%N Query with {nick $0} changed to server {server $1}";

    hilight_header = "%#%Z7D4E00⟫%N Highlights:";
    hilight_line = "%#  %Z7D4E00$[-4]0%N $1 $2 $3$4";
    hilight_footer = "";
    hilight_not_found = "%ZCF222E✗%N Highlight not found: $0";
    hilight_removed = "%Z1A7F37✓%N Highlight removed: $0";

    alias_added = "%Z1A7F37✓%N Alias $0 added";
    alias_removed = "%Z1A7F37✓%N Alias $0 removed";
    alias_not_found = "%ZCF222E✗%N No such alias: $0";
    aliaslist_header = "%#%Z0969DA⟫%N Aliases:";
    aliaslist_line = "%#  %Z0969DA◆%N $[10]0 %Z687079⟫%N $1";
    aliaslist_footer = "";

    log_opened = "%Z1A7F37≡%N Log file {hilight $0} opened";
    log_closed = "%Z687079≡%N Log file {hilight $0} closed";
    log_create_failed = "%ZCF222E✗%N Couldn't create log file {hilight $0}: $1";
    log_locked = "%ZCF222E!%N Log file {hilight $0} is locked, probably by another running erssi";
    log_not_open = "%ZCF222E✗%N Log file {hilight $0} not open";
    log_started = "%Z1A7F37≡%N Started logging to file {hilight $0}";
    log_stopped = "%Z687079≡%N Stopped logging to file {hilight $0}";
    log_list_header = "%#Logs:";
    log_list = "%#$0 $1: $2 $3$4$5";
    log_list_footer = "";
    windowlog_file = "%Z1A7F37≡%N Window LOGFILE set to $0";
    windowlog_file_logging = "%ZCF222E✗%N Can't change window's logfile while log is on";

    no_away_msgs = "%Z1A7F37◆%N No new messages in awaylog";
    away_msgs = "%Z7D4E00◇%N {hilight $1} new messages in awaylog:";
    away = "            %Z7D4E00◇{col}You have been marked as being away";
    unaway = "            %Z1A7F37◆{col}You are no longer marked as being away";

    module_header = "%#%Z9A6700⚙%N Module               Type    Submodules";
    module_line = "%#  %Z0969DA◆%N $[!20]0 %Z8250DF$[7]1%N $2";
    module_footer = "";
    module_already_loaded = "%Z7D4E00⚠%N Module {hilight $0/$1} already loaded";
    module_not_loaded = "%ZCF222E✗%N Module {hilight $0/$1} is not loaded";
    module_load_error = "%ZCF222E✗%N Error loading module {hilight $0/$1}: $2";
    module_invalid = "%ZCF222E✗%N {hilight $0/$1} isn't erssi module";
    module_loaded = "%Z1A7F37⚙%N Loaded module {hilight $0/$1}";
    module_unloaded = "%Z687079⚙%N Unloaded module {hilight $0/$1}";

    command_unknown = "%ZCF222E✗%N Unknown command: $0";
    command_ambiguous = "%Z7D4E00⚠%N Ambiguous command: $0";
    option_unknown = "%ZCF222E✗%N Unknown option: $0";
    option_ambiguous = "%Z7D4E00⚠%N Ambiguous option: $0";
    option_missing_arg = "%ZCF222E✗%N Missing required argument for: $0";
    not_enough_params = "%ZCF222E✗%N Not enough parameters given";
    not_connected = "%ZCF222E✗%N Not connected to server";
    not_joined = "%ZCF222E✗%N Not joined to any channel";
    chan_not_found = "%ZCF222E✗%N Not joined to such channel";
    chan_not_synced = "%Z7D4E00⚠%N Channel not fully synchronized yet, try again after a while";
    illegal_proto = "%ZCF222E✗%N Command isn't designed for the chat protocol of the active server";
    not_good_idea = "%Z7D4E00⚠%N Doing this is not a good idea. Add -YES option to command if you really mean it";
    invalid_number = "%ZCF222E✗%N Invalid number";
    invalid_time = "%ZCF222E✗%N Invalid timestamp";
    invalid_level = "%ZCF222E✗%N Invalid message level";
    invalid_size = "%ZCF222E✗%N Invalid size";
    invalid_charset = "%ZCF222E✗%N Invalid charset: $0";
    eval_max_recurse = "%ZCF222E✗%N /eval hit maximum recursion limit";
    program_not_found = "%ZCF222E✗%N Could not find file or file is not executable";

    theme_saved = "%Z1A7F37✓%N Theme saved to $0";
    theme_save_failed = "%ZCF222E✗%N Error saving theme to $0: $1";
    theme_not_found = "%ZCF222E✗%N Theme {hilight $0} not found";
    theme_changed = "%Z1A7F37✓%N Now using theme {hilight $0} ($1)";
