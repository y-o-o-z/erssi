    window_not_sticky = "%Z1A7F37✓%N Window is not sticky";
    window_set_sticky = "%Z1A7F37✓%N Window set sticky";
    window_unset_sticky = "%Z1A7F37✓%N Window is not sticky anymore";
    window_info_sticky = "%#Sticky  : $0";
    window_info_scroll = "%#Scroll  : $0";
    window_scroll = "%Z1A7F37✓%N Window scroll mode is now $0";
    window_scroll_unknown = "%ZCF222E⚠%N Unknown scroll mode $0, must be ON, OFF or DEFAULT";

    # Statusbar management
    statusbar_list_header = "%#Name                           Type   Placement Position Visible";
    statusbar_list_footer = "";
    statusbar_list = "%#$[30]0 $[6]1 $[9]2 $[8]3 $4";
    statusbar_info_name = "%#Statusbar: {hilight $0}";
    statusbar_info_type = "%#Type     : $0";
    statusbar_info_placement = "%#Placement: $0";
    statusbar_info_position = "%#Position : $0";
    statusbar_info_visible = "%#Visible  : $0";
    statusbar_info_item_header = "%#Items    : Name                                Priority  Alignment";
    statusbar_info_item_footer = "";
    statusbar_info_item_name = "%#         : $[35]0 $[9]1 $2";
    statusbar_not_found = "%ZCF222E⚠%N Statusbar doesn't exist: $0";
    statusbar_item_not_found = "%ZCF222E⚠%N Statusbar item doesn't exist: $0";
    statusbar_unknown_command = "%ZCF222E⚠%N Unknown statusbar command: $0";
    statusbar_unknown_type = "%ZCF222E⚠%N Statusbar type must be 'window' or 'root'";
    statusbar_unknown_placement = "%ZCF222E⚠%N Statusbar placement must be 'top' or 'bottom'";
    statusbar_unknown_visibility = "%ZCF222E⚠%N Statusbar visibility must be 'always', 'active' or 'inactive'";

    # Paste warning
    paste_warning = "%Z7D4E00⚠%N Pasting $0 lines to $1. Press Ctrl-K if you wish to do this or Ctrl-C to cancel.";
    paste_prompt = "%Z7D4E00⚠%N Hit Ctrl-K to paste, Ctrl-C to abort?";

    # === ENHANCED SIDEPANEL THEME ===
    # Format: $0 = window number, $1 = window name
    sidepanel_header = "%Z687079$[-2]0%N %Z9A6700%_$1%_%N";
    sidepanel_item = "%Z687079$[-2]0%N %Z59636E$1%N";
    sidepanel_item_selected = "%Z9A6700$[-2]0%N %Z7D4E00%_$1%_%N";

    # === ACTIVITY HIERARCHY (by priority) ===
    sidepanel_item_nick_mention = "%ZCF222E$[-2]0%N %ZCF222E%_$1%_%N";
    sidepanel_item_query_msg = "%Z8250DF$[-2]0%N %Z8250DF%_$1%_%N";
    sidepanel_item_activity = "%Z687079$[-2]0%N %Z1F2328$1%N";
    sidepanel_item_events = "%Z687079$[-2]0%N %Z0969DA$1%N";
    sidepanel_item_highlight = "%ZCF222E$[-2]0%N %ZCF222E$1%N";

    # Nick list: status symbol ($0) and nick ($1) in the colour of the rank -
    # the same colours as the mode prefix in messages (nick_mode_color_*):
    # ops amber, voice blue, halfop green, owner red, everyone else grey
    sidepanel_nick_owner_status = " %ZCF222E%_$0%_%N%ZA40E26$1%N";
    sidepanel_nick_admin_status = " %ZCF222E%_$0%_%N%ZA40E26$1%N";
    sidepanel_nick_op_status = " %Z9A6700%_$0%_%N%Z7D4E00$1%N";
    sidepanel_nick_halfop_status = " %Z1A7F37%_$0%_%N%Z116329$1%N";
    sidepanel_nick_voice_status = " %Z0969DA%_$0%_%N%Z0A50AE$1%N";
    sidepanel_nick_normal_status = " %Z687079$0%N%Z59636E$1%N";

    # Arrows at the top/bottom of a panel with more entries than fit
    # ($0 is the arrow), on the panel background
    sidepanel_scroll_arrow = "%Z9A6700$0%N";
  };

